<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Helide</AssemblyName>
    <RootNamespace>Helide</RootNamespace>
    <Product>Helide</Product>
    <Version>1.6.3</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <ApplicationIcon>src\Assets\helide.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\CheckNInstall\**\*" />
    <Compile Remove="tools\AutoUpdater\**\*" />
    <None Remove="tools\CheckNInstall\**\*" />
    <Content Remove="tools\CheckNInstall\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
  </ItemGroup>

  <ItemGroup>
    <!-- The yazi config Helide offers to install into the user's own yazi config
         directory. Embedded rather than copied beside the exe because Helide publishes
         as a single file and these have to land somewhere else entirely at runtime;
         LogicalName keeps the manifest names stable instead of deriving them from the
         folder path. -->
    <EmbeddedResource Include="src\Config\Yazi\yazi.toml" LogicalName="Helide.YaziConfig.yazi.toml" />
    <EmbeddedResource Include="src\Config\Yazi\keymap.toml" LogicalName="Helide.YaziConfig.keymap.toml" />
    <EmbeddedResource Include="src\Config\Yazi\theme.toml" LogicalName="Helide.YaziConfig.theme.toml" />
    <EmbeddedResource Include="src\Config\Yazi\open-with-helix.ps1" LogicalName="Helide.YaziConfig.open-with-helix.ps1" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="src\App\App.xaml" />
    <ApplicationDefinition Include="src\App\App.xaml" />
    <Resource Include="src\Assets\helide.png" />
    <Resource Include="src\Assets\icons\git.png" />
    <Resource Include="src\Assets\icons\project.png" />
    <Resource Include="src\Assets\icons\terminal.png" />
    <Resource Include="src\Assets\icons\agent.png" />
    <None Include="src\Assets\helide.svg" />
    <None Include="src\Assets\icons\git.svg" />
    <None Include="src\Assets\icons\project.svg" />
    <None Include="src\Assets\icons\terminal.svg" />
    <None Include="src\Assets\icons\agent.svg" />
  </ItemGroup>

  <PropertyGroup>
    <_HelideArtifactName>Helide-$(RuntimeIdentifier).exe</_HelideArtifactName>
    <_HelideArtifactName Condition="'$(RuntimeIdentifier)' == ''">Helide.exe</_HelideArtifactName>
  </PropertyGroup>

  <UsingTask TaskName="FlattenPublishOutput" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutDir ParameterType="System.String" Required="true" />
      <PublishName ParameterType="System.String" Required="true" />
      <FinalName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          var loose = Path.GetFullPath(OutDir);
          var root = Path.GetDirectoryName(loose.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
          var publish = Path.GetFullPath(Path.Combine(loose, PublishName));

          if (Directory.Exists(publish))
          {
              Directory.CreateDirectory(root);

              var bundled = Directory.EnumerateFiles(publish).ToList();
              foreach (var file in bundled)
              {
                  var name = bundled.Count == 1 ? FinalName : Path.GetFileName(file);
                  var target = Path.Combine(root, name);
                  if (File.Exists(target))
                      File.Delete(target);
                  File.Move(file, target);
              }

              Directory.Delete(publish, true);
          }

          foreach (var file in Directory.EnumerateFiles(loose))
              File.Delete(file);

          foreach (var dir in Directory.EnumerateDirectories(loose))
              Directory.Delete(dir, true);

          Directory.Delete(loose, true);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="DropNativeDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_SymbolJunk Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_SymbolJunk)" />
  </Target>

  <Target Name="FlattenPublishIntoArtifact" AfterTargets="Publish">
    <FlattenPublishOutput OutDir="$(OutDir)" PublishName="publish" FinalName="$(_HelideArtifactName)" />
  </Target>

</Project>
