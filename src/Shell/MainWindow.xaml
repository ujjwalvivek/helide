<Window
    x:Class="Helide.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Helide"
    Height="900"
    Width="1500"
    MinHeight="640"
    MinWidth="1050"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    Foreground="#cdd6f4"
    FontFamily="Segoe UI Variable Text"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="42"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="10"
            UseAeroCaptionButtons="False"
        />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#D9191724" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#E6181825" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#E6313244" />
        <SolidColorBrush x:Key="TerminalBrush" Color="#191724" />
        <SolidColorBrush x:Key="BorderBrush" Color="#313244" />
        <SolidColorBrush x:Key="AccentBrush" Color="#89b4fa" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7f849c" />

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#bac2de" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="#313244"
                                />
                                <Setter Property="Foreground" Value="#cdd6f4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="#45475a"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="WelcomeActionStyle"
            TargetType="Button"
            BasedOn="{StaticResource ChromeButtonStyle}"
        >
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#89b4fa" />
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#cdd6f4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CaptionSurface"
                            Background="{TemplateBinding Background}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="CaptionSurface"
                                    Property="Background"
                                    Value="#313244"
                                />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="CaptionSurface"
                                    Property="Background"
                                    Value="#45475a"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CloseCaptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource CaptionButtonStyle}"
        >
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c42b1c" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9f2318" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="RecentProjectStyle"
            TargetType="Button"
            BasedOn="{StaticResource ChromeButtonStyle}"
        >
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="TerminalSlotStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter
                Property="Background"
                Value="{StaticResource TerminalBrush}"
            />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="VerticalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Width="1"
                                Background="#313244"
                                HorizontalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Height="1"
                                Background="#313244"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="27" />
            <Setter Property="Background" Value="#181825" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>

        <Style x:Key="PanelToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#89b4fa" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ToggleSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                The icons are pre-tinted PNGs so an unchecked toggle can
                                dim without losing colour: accent when shown, muted when
                                hidden, bright on hover.
                            -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="0.42"
                                />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Background"
                                    Value="#313244"
                                />
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="1"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelIconStyle" TargetType="Image">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid x:Name="MaximizeInset" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
            >
            <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                    >
                    <Button
                            x:Name="HomeButton"
                            Click="HomeButton_Click"
                            Style="{StaticResource ChromeButtonStyle}"
                            Width="30"
                            Height="30"
                            Padding="5"
                            ToolTip="Welcome"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        >
                        <Image
                                Source="/src/Assets/helide.png"
                                Width="18"
                                Height="18"
                                RenderOptions.BitmapScalingMode="HighQuality"
                            />
                    </Button>
                    <TextBlock
                            x:Name="WindowTitleText"
                            Text="Open Recent Project"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#cdd6f4"
                            FontSize="12"
                            FontWeight="SemiBold"
                        />
                </StackPanel>

                <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                    >
                    <Button
                            x:Name="RunCommandButton"
                            Click="RunCommandButton_Click"
                            Style="{StaticResource ChromeButtonStyle}"
                            Content="Run project"
                            Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        />
                    <Button
                            x:Name="OpenFolderTopButton"
                            Click="OpenProjectButton_Click"
                            Style="{StaticResource ChromeButtonStyle}"
                            Content="Open folder…"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        />
                </StackPanel>
                <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                    <Button
                            Click="MinimizeCaptionButton_Click"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                        />
                    <Button
                            Click="MaximizeRestoreCaptionButton_Click"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Maximize or restore"
                        >
                        <TextBlock FontFamily="Segoe Fluent Icons">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger
                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="Maximized"
                                            >
                                            <Setter
                                                    Property="Text"
                                                    Value="&#xE923;"
                                                />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button
                            Click="CloseCaptionButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                        />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid
                    x:Name="WelcomeRoot"
                    Background="{StaticResource WindowBrush}"
                >
                <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                    >
                    <Grid MinHeight="650" Margin="48">
                        <StackPanel
                                Width="680"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            >
                            <StackPanel
                                    Orientation="Horizontal"
                                    Margin="10,0,10,28"
                                >
                                <Border
                                        Width="60"
                                        Height="60"
                                        CornerRadius="16"
                                        Margin="0,0,18,0"
                                        Background="Transparent"
                                    >
                                    <Image
                                            Source="/src/Assets/helide.png"
                                            Width="60"
                                            Height="60"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                        />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                            Text="Helide"
                                            FontSize="27"
                                            FontWeight="SemiBold"
                                            Foreground="#cdd6f4"
                                        />
                                    <TextBlock
                                            Text="Keep the editor you love. Bring the project tools you need."
                                            Margin="0,4,0,0"
                                            FontSize="13"
                                            FontStyle="Italic"
                                            Foreground="#a6adc8"
                                        />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                    Text="GET STARTED"
                                    Margin="0,0,0,7"
                                    FontFamily="Cascadia Mono"
                                    FontSize="9"
                                    Foreground="#6c7086"
                                />
                            <Border
                                    Height="1"
                                    Background="{StaticResource BorderBrush}"
                                />

                            <Button
                                    x:Name="OpenProjectButton"
                                    Click="OpenProjectButton_Click"
                                    Style="{StaticResource WelcomeActionStyle}"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Text="+"
                                            FontFamily="Cascadia Mono"
                                        />
                                    <TextBlock
                                            Grid.Column="1"
                                            Text="Open project folder"
                                        />
                                    <TextBlock
                                            Grid.Column="2"
                                            Text="Ctrl+O"
                                            Foreground="#7f849c"
                                            FontFamily="Cascadia Mono"
                                            FontSize="10"
                                        />
                                </Grid>
                            </Button>

                            <Button
                                    x:Name="ContinueProjectButton"
                                    Click="ContinueProjectButton_Click"
                                    Style="{StaticResource WelcomeActionStyle}"
                                    Visibility="Collapsed"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Text="↻"
                                            FontFamily="Cascadia Mono"
                                        />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                                Text="Continue last workspace"
                                            />
                                        <TextBlock
                                                x:Name="ContinueProjectPathText"
                                                FontSize="10"
                                                Foreground="#7f849c"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                    </StackPanel>
                                    <TextBlock
                                            Grid.Column="2"
                                            Text="Enter"
                                            Foreground="#7f849c"
                                            FontFamily="Cascadia Mono"
                                            FontSize="10"
                                        />
                                </Grid>
                            </Button>

                            <TextBlock
                                    Text="RECENT PROJECTS"
                                    Margin="0,22,0,7"
                                    FontFamily="Cascadia Mono"
                                    FontSize="9"
                                    Foreground="#6c7086"
                                />
                            <Border
                                    Height="1"
                                    Background="{StaticResource BorderBrush}"
                                />

                            <ItemsControl x:Name="RecentProjectItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                                Click="RecentProject_Click"
                                                Tag="{Binding Path}"
                                                Style="{StaticResource RecentProjectStyle}"
                                            >
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
                                                            Width="28"
                                                        />
                                                    <ColumnDefinition
                                                            Width="*"
                                                        />
                                                    <ColumnDefinition
                                                            Width="Auto"
                                                        />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                        Text="▱"
                                                        Foreground="#89b4fa"
                                                        FontSize="12"
                                                    />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                            Text="{Binding Name}"
                                                            Foreground="#cdd6f4"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                        />
                                                    <TextBlock
                                                            Text="{Binding Path}"
                                                            Foreground="#7f849c"
                                                            FontFamily="Cascadia Mono"
                                                            FontSize="9"
                                                            TextTrimming="CharacterEllipsis"
                                                        />
                                                </StackPanel>
                                                <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding Shortcut}"
                                                        Foreground="#7f849c"
                                                        FontFamily="Cascadia Mono"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                    />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                    x:Name="RecentEmptyText"
                                    Text="No recent projects yet."
                                    Margin="10,14"
                                    Foreground="#7f849c"
                                    FontStyle="Italic"
                                />
                            <TextBlock
                                    x:Name="WelcomeStatus"
                                    Margin="8,20,8,0"
                                    Text="Helix  ·  git / project  ·  runner  ·  OpenCode"
                                    Foreground="#6c7086"
                                    FontFamily="Cascadia Mono"
                                    FontSize="10"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid
                    x:Name="WorkspaceRoot"
                    Visibility="Collapsed"
                    Background="{StaticResource TerminalBrush}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid
                        Grid.Row="0"
                        x:Name="PaneGrid"
                        Background="{StaticResource TerminalBrush}"
                    >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                                x:Name="LeftPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                        <ColumnDefinition
                                x:Name="LeftSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="CenterPaneColumn"
                                Width="58*"
                                MinWidth="500"
                            />
                        <ColumnDefinition
                                x:Name="RightSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="RightPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="LeftPane"
                        Grid.Column="0"
                    >
                        <Grid.RowDefinitions><RowDefinition
                                    Height="27"
                                /><RowDefinition
                                    Height="*"
                                /></Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{StaticResource PaneHeaderStyle}"
                            >
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Column="0"
                                        x:Name="LeftPaneTitle"
                                        Text="GIT"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono"
                                        FontSize="9"
                                        Foreground="#a9a8b6"
                                    />
                                <TextBlock
                                        Grid.Column="1"
                                        x:Name="GitPaneState"
                                        Text="starting"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#666779"
                                        FontSize="10"
                                    />
                                <TextBlock
                                        Grid.Column="1"
                                        x:Name="ProjectPaneState"
                                        Text="starting"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#666779"
                                        FontSize="10"
                                        Visibility="Collapsed"
                                    />
                            </Grid>
                        </Border>
                        <Grid
                                Grid.Row="1"
                                x:Name="LeftToolStack"
                                Background="{StaticResource TerminalBrush}"
                            />
                    </Grid>

                    <GridSplitter
                            Grid.Column="1"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                    x:Name="EditorPaneRow"
                                    Height="80*"
                                    MinHeight="220"
                                />
                            <RowDefinition
                                    x:Name="RunnerSplitterRow"
                                    Height="3"
                                />
                            <RowDefinition
                                    x:Name="RunnerPaneRow"
                                    Height="20*"
                                    MinHeight="100"
                                />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{StaticResource PaneHeaderStyle}"
                                >
                                <DockPanel Margin="9,0" LastChildFill="False">
                                    <TextBlock
                                            DockPanel.Dock="Left"
                                            Text="HELIX"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono"
                                            FontSize="9"
                                            Foreground="#a9a8b6"
                                        />
                                    <Border
                                            DockPanel.Dock="Left"
                                            Width="1"
                                            Margin="8,6"
                                            Background="#313244"
                                            VerticalAlignment="Center"
                                        />
<Border
                                            DockPanel.Dock="Left"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            MaxWidth="560"
                                            Margin="9,0,0,0"
                                            Background="Transparent"
                                            ClipToBounds="True">
                                            <!-- The tab strip is clipped to the header row, so a
                                                 long list of tabs slides out of sight instead of
                                                 spilling down the pane. -->
                                            <ScrollViewer
                                                    HorizontalScrollBarVisibility="Auto"
                                                    VerticalScrollBarVisibility="Disabled"
                                                    Focusable="False"
                                            >
                                                <ItemsControl x:Name="EditorTabStrip">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
<Border
                                                                    Background="{Binding Background}"
                                                                    Padding="9,0,4,0"
                                                                    BorderThickness="0,0,0,2"
                                                                    BorderBrush="{Binding Underline}"
                                                                    ToolTip="{Binding ToolTipText}">
                                                                <StackPanel
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                    <!-- Activation is bound to the label rather
                                                                         than to the whole tab. With the close
                                                                         button inside a tab that also handled
                                                                         MouseLeftButtonUp, the two targets
                                                                         competed and the close never fired. -->
                                                                    <TextBlock
                                                                            Text="{Binding Name}"
                                                                            FontFamily="Cascadia Mono"
                                                                            FontSize="10"
                                                                            Foreground="{Binding Foreground}"
                                                                            FontWeight="{Binding Weight}"
                                                                            MaxWidth="160"
                                                                            Padding="0,0,6,0"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            VerticalAlignment="Center"
                                                                            Cursor="Hand"
                                                                            Tag="{Binding}"
                                                                            MouseLeftButtonUp="EditorTab_Click"
                                                                    />
                                                                    <!-- A real button rather than a glyph to aim
                                                                         at, and a generous one: 16x16 was easy to
                                                                         miss in a header row this short. -->
                                                                    <Button
                                                                            Width="20"
                                                                            Height="22"
                                                                            Padding="0"
                                                                            Click="EditorTab_Close"
                                                                            Tag="{Binding}"
                                                                            Content="×"
                                                                            FontFamily="Cascadia Mono"
                                                                            FontSize="12"
                                                                            Foreground="{Binding Foreground}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            ToolTip="Close this tab"
                                                                    >
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border
                                                                                        x:Name="CloseSurface"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        CornerRadius="3"
                                                                                >
                                                                                    <ContentPresenter
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"
                                                                                    />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="CloseSurface" Property="Background" Value="#f38ba8" />
                                                                                        <Setter Property="Foreground" Value="#11111b" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <Button
                                                x:Name="EditorTabSplitButton"
                                                Width="22"
                                                Height="27"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                Click="EditorTabSplitButton_Click"
                                                Content="+"
                                                FontFamily="Cascadia Mono"
                                                FontSize="12"
                                                Foreground="#7f849c"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="New empty editor tab"
                                        >
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                            x:Name="SplitSurface"
                                                            Background="{TemplateBinding Background}"
                                                            Width="22"
                                                            Height="27"
                                                    >
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SplitSurface" Property="Background" Value="#313244" />
                                                            <Setter Property="Foreground" Value="#cdd6f4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    <TextBlock
                                            DockPanel.Dock="Right"
                                            x:Name="EditorPaneState"
                                            Text="starting"
                                            VerticalAlignment="Center"
                                            Foreground="#666779"
                                            FontSize="10"
                                        />
                                </DockPanel>
                            </Border>
                            <Grid
                                    Grid.Row="1"
                                    x:Name="EditorSlot"
                                    Background="{StaticResource TerminalBrush}"
                                />
                        </Grid>
                        <GridSplitter
                                Grid.Row="1"
                                Height="3"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource HorizontalSplitterStyle}"
                                DragCompleted="LayoutSplitter_DragCompleted"
                            />
                        <Grid
                                x:Name="RunnerPane"
                                Grid.Row="2"
                            >
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{StaticResource PaneHeaderStyle}"
                                >
                                <DockPanel Margin="9,0" LastChildFill="False">
                                    <TextBlock
                                            DockPanel.Dock="Left"
                                            Text="RUN"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono"
                                            FontSize="9"
                                            Foreground="#a9a8b6"
                                        />
                                    <Border
                                            DockPanel.Dock="Left"
                                            Width="1"
                                            Margin="8,6"
                                            Background="#313244"
                                            VerticalAlignment="Center"
                                        />
                                    <Border
                                            DockPanel.Dock="Left"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            MaxWidth="300"
                                            Margin="9,0,0,0"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                        >
                                        <ScrollViewer
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Disabled"
                                                Focusable="False"
                                            >
                                            <ItemsControl x:Name="RunnerTabStrip" Margin="0,1,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                                Background="{Binding Background}"
                                                                Padding="9,0,4,0"
                                                                BorderThickness="0,0,0,2"
                                                                BorderBrush="{Binding Underline}"
                                                                ToolTip="{Binding Name}"
                                                        >
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock
                                                                    Text="{Binding Name}"
                                                                        FontFamily="Cascadia Mono"
                                                                        FontSize="10"
                                                                        Foreground="{Binding Foreground}"
                                                                        FontWeight="{Binding Weight}"
                                                                        MaxWidth="70"
                                                                        Padding="0,0,4,0"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        VerticalAlignment="Center"
                                                                        Cursor="Hand"
                                                                        Tag="{Binding}"
                                                                        MouseLeftButtonUp="RunnerTabStrip_Click"
                                                                    />
                                                                <Button
                                                                        Width="16"
                                                                        Height="22"
                                                                        Padding="0"
                                                                        Click="RunnerTabClose_Click"
                                                                        Tag="{Binding}"
                                                                        Content="×"
                                                                        FontFamily="Cascadia Mono"
                                                                        FontSize="10"
                                                                        Foreground="#7f849c"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        ToolTip="Close session"
                                                                    >
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border
                                                                                    x:Name="CloseSurface"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="3"
                                                                                    Width="16"
                                                                                    Height="22"
                                                                                >
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="CloseSurface" Property="Background" Value="#f38ba8" />
                                                                                    <Setter Property="Foreground" Value="#11111b" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <Button
                                            x:Name="RunnerNewSessionButton"
                                            Click="RunnerNewSessionButton_Click"
                                            ToolTip="New runner session"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="22"
                                            Height="27"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            Foreground="#7f849c"
                                            Cursor="Hand"
                                            FontFamily="Cascadia Mono"
                                            FontSize="12"
                                            Content="+"
                                        >
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                        x:Name="SplitSurface"
                                                        Background="{TemplateBinding Background}"
                                                        Width="22"
                                                        Height="27"
                                                    >
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SplitSurface" Property="Background" Value="#313244" />
                                                        <Setter Property="Foreground" Value="#cdd6f4" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock
                                            DockPanel.Dock="Right"
                                            x:Name="RunnerPaneState"
                                            Text="starting"
                                            VerticalAlignment="Center"
                                            Foreground="#666779"
                                            FontSize="10"
                                        />
                                </DockPanel>
                            </Border>
                            <ContentControl
                                    Grid.Row="1"
                                    x:Name="RunnerSlot"
                                    Style="{StaticResource TerminalSlotStyle}"
                                />
                        </Grid>
                    </Grid>

                    <GridSplitter
                            Grid.Column="3"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                        <Grid
                            x:Name="AgentPane"
                            Grid.Column="4"
                        >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" MinHeight="32" />
                            </Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{StaticResource PaneHeaderStyle}"
                            >
                            <DockPanel Margin="9,0" LastChildFill="False">
                                <!-- Title -->
                                <TextBlock
                                        DockPanel.Dock="Left"
                                        x:Name="AgentPaneTitle"
                                        Text="OPENCODE"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono"
                                        FontSize="9"
                                        Foreground="#a9a8b6"
                                    />
                                <!-- Separator -->
                                <Border
                                        DockPanel.Dock="Left"
                                        Width="1"
                                        Margin="8,6"
                                        Background="#313244"
                                        VerticalAlignment="Center"
                                    />
                                <!-- Session tab strip -->
                                <Border
                                        DockPanel.Dock="Left"
                                        VerticalAlignment="Stretch"
                                        Height="27"
                                        MaxWidth="400"
                                        Margin="9,0,0,0"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                    >
                                    <ScrollViewer
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled"
                                            Focusable="False"
                                        >
                                        <ItemsControl x:Name="AgentTabStrip" Margin="0,1,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                        <Border
                                                                Background="{Binding Background}"
                                                                Padding="9,0,4,0"
                                                                BorderThickness="0,0,0,2"
                                                                BorderBrush="{Binding Underline}"
                                                                ToolTip="{Binding Name}"
                                                            >
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock
                                                                        Text="{Binding Name}"
                                                                    FontFamily="Cascadia Mono"
                                                                    FontSize="10"
                                                                    Foreground="{Binding Foreground}"
                                                                    FontWeight="{Binding Weight}"
                                                                    MaxWidth="70"
                                                                    Padding="0,0,4,0"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    MouseLeftButtonUp="AgentTabStrip_Click"
                                                                />
                                                            <Button
                                                                    Width="16"
                                                                    Height="22"
                                                                    Padding="0"
                                                                    Click="AgentTabClose_Click"
                                                                    Tag="{Binding}"
                                                                    Content="×"
                                                                    FontFamily="Cascadia Mono"
                                                                    FontSize="10"
                                                                    Foreground="#7f849c"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    ToolTip="Close session"
                                                                >
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                                x:Name="CloseSurface"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="3"
                                                                                Width="16"
                                                                                Height="22"
                                                                            >
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="CloseSurface" Property="Background" Value="#f38ba8" />
                                                                                <Setter Property="Foreground" Value="#11111b" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <!-- + icon -->
                                <Button
                                        x:Name="AgentNewSessionButton"
                                        Click="AgentNewSessionButton_Click"
                                        ToolTip="New agent session"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="22"
                                        Height="27"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Foreground="#7f849c"
                                        Cursor="Hand"
                                        FontFamily="Cascadia Mono"
                                        FontSize="12"
                                        Content="+"
                                    >
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                    x:Name="SplitSurface"
                                                    Background="{TemplateBinding Background}"
                                                    Width="22"
                                                    Height="27"
                                                >
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SplitSurface" Property="Background" Value="#313244" />
                                                    <Setter Property="Foreground" Value="#cdd6f4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- State -->
                                <TextBlock
                                        DockPanel.Dock="Right"
                                        x:Name="AgentPaneState"
                                        Text="starting"
                                        VerticalAlignment="Center"
                                        Foreground="#666779"
                                        FontSize="10"
                                    />
                            </DockPanel>
                        </Border>
                        <!-- Flyout for new agent session -->
                        <Popup
                                x:Name="AgentNewSessionFlyout"
                                PlacementTarget="{Binding ElementName=AgentNewSessionButton}"
                                Placement="Bottom"
                                StaysOpen="False"
                                AllowsTransparency="True"
                            >
                            <Border
                                    Background="#181825"
                                    BorderBrush="#313244"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                >
                                <StackPanel>
                                    <TextBlock
                                            Text="NEW SESSION"
                                            FontFamily="Cascadia Mono"
                                            FontSize="9"
                                            Foreground="#6c7086"
                                            Margin="0,0,0,6"
                                        />
                                    <Button
                                            x:Name="NewOpenCodeButton"
                                            Click="NewOpenCodeButton_Click"
                                            Style="{StaticResource WelcomeActionStyle}"
                                            Padding="8,4"
                                            Margin="0,0,0,4"
                                            HorizontalContentAlignment="Left"
                                        >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Foreground="#89b4fa" Margin="0,0,6,0" />
                                            <TextBlock Text="New OpenCode session" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                            x:Name="NewCodexButton"
                                            Click="NewCodexButton_Click"
                                            Style="{StaticResource WelcomeActionStyle}"
                                            Padding="8,4"
                                            HorizontalContentAlignment="Left"
                                        >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF0A0;" FontFamily="Segoe Fluent Icons" Foreground="#89b4fa" Margin="0,0,6,0" />
                                            <TextBlock Text="New Codex session" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- Agent session content -->
                        <ContentControl
                                Grid.Row="1"
                                x:Name="AgentSlot"
                                Style="{StaticResource TerminalSlotStyle}"
                            />
                    </Grid>
                </Grid>

                <Border
                        Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                    >
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="GitPanelToggle"
                                    Click="GitPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{StaticResource PanelToggleStyle}"
                                    ToolTip="Show git panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/git.png"
                                            Style="{StaticResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="ProjectPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="ProjectPanelToggle_Click"
                                    IsChecked="False"
                                    Style="{StaticResource PanelToggleStyle}"
                                    ToolTip="Show project panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/project.png"
                                            Style="{StaticResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                        </StackPanel>
                        <TextBlock
                                x:Name="ProjectStatus"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="#a6adc8"
                                FontFamily="Cascadia Mono"
                                FontSize="10"
                                TextTrimming="CharacterEllipsis"
                            />
                        <TextBlock
                                Grid.Column="2"
                                x:Name="WorkspaceHealthText"
                                Text="starting tools"
                                Margin="14,0"
                                VerticalAlignment="Center"
                                Foreground="#7f849c"
                                FontFamily="Cascadia Mono"
                                FontSize="10"
                            />
                        <TextBlock
                                Grid.Column="3"
                                Text="Ctrl+1 Left   Ctrl+2 Helix   Ctrl+3 Run   Ctrl+4 OpenCode   Ctrl+5 Project"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="#6c7086"
                                FontFamily="Cascadia Mono"
                                FontSize="9"
                            />
                        <StackPanel
                                Grid.Column="4"
                                Margin="4,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="TerminalPanelToggle"
                                    Click="TerminalPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{StaticResource PanelToggleStyle}"
                                    ToolTip="Show terminal panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/terminal.png"
                                            Style="{StaticResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="AgentPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="AgentPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{StaticResource PanelToggleStyle}"
                                    ToolTip="Show agent panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/agent.png"
                                            Style="{StaticResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
