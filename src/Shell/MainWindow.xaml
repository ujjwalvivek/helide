<Window
    x:Class="Helide.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:ui="clr-namespace:Helide.Shell"
    Title="Helide"
    Height="900"
    Width="1500"
    MinHeight="640"
    MinWidth="1050"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    Foreground="{DynamicResource TextBrush}"
    FontFamily="{DynamicResource UiFontFamily}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"
        />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Built-in, because the two visibilities are computed by the view models rather
             than combined here. FrameworkElement.Triggers accepts EventTrigger only, so
             a DataTrigger on the tab Border would throw as soon as a strip renders. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The x on a tab. Drawn rather than typed, so it sits on the pixel grid at this
             size instead of wherever the font's glyph happens to land. -->
        <Style x:Key="TabCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="{TemplateBinding Background}">
                            <Path
                                Data="M5.5,5.5 L12.5,12.5 M12.5,5.5 L5.5,12.5"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.2"
                                SnapsToDevicePixels="True"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One tab, for all three strips. The editor, runner and agent strips used to
             carry a copy each, and the copies had drifted: different widths, different
             close buttons, and three sets of handlers.

             Two borders on purpose. The inner one takes its fill from the view model,
             which is transparent for an inactive tab, so the outer one's hover colour
             shows through it; a single border could not do both, because a bound
             Background outranks a style trigger.

             The active tab is the colour of the pane beneath it and reaches one pixel
             over the header's bottom line, so it reads as part of the pane rather than
             as a button above it. -->
        <DataTemplate x:Key="PaneTabTemplate">
            <Border
                Margin="0,0,1,-1"
                Cursor="Hand"
                ToolTip="{Binding ToolTipText}"
                MouseEnter="Tab_MouseEnter"
                MouseLeave="Tab_MouseLeave"
                PreviewMouseLeftButtonDown="Tab_PointerDown"
                MouseMove="Tab_PointerMove"
                MouseLeftButtonUp="Tab_PointerUp"
                LostMouseCapture="Tab_LostCapture"
            >
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource InteractiveBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border
                    Background="{Binding Background}"
                    BorderBrush="{Binding Underline}"
                    BorderThickness="0,2,0,0"
                    Padding="10,0,4,2"
                >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Name}"
                            FontFamily="{DynamicResource UiMonoFontFamily}"
                            FontSize="{DynamicResource FontSizeSmall}"
                            Foreground="{Binding Foreground}"
                            FontWeight="{Binding Weight}"
                            MaxWidth="150"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                        />
                        <Grid Width="18" Height="18" Margin="5,0,0,0">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Fill="{DynamicResource SuccessBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowAttentionDot, Converter={StaticResource BoolToVis}}"
                            />
                            <Button
                                Click="Tab_Close"
                                Style="{StaticResource TabCloseStyle}"
                                ToolTip="Close"
                                Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                            />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <!-- A row on the welcome screen: a box, and the pointer only lights its edge.
             Filling the whole box on hover made a list of them flash as the mouse
             crossed it. -->
        <Style x:Key="WelcomeRowStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Box"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                        >
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PressedStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in a small menu, such as the one that picks an agent. -->
        <Style x:Key="MenuRowStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0,14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RowSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2,0,0,0"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource PressedBrush}"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="WelcomeActionStyle"
            TargetType="Button"
            BasedOn="{StaticResource ChromeButtonStyle}"
        >
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CaptionSurface"
                            Background="{TemplateBinding Background}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="CaptionSurface"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="CaptionSurface"
                                    Property="Background"
                                    Value="{DynamicResource PressedBrush}"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CloseCaptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource CaptionButtonStyle}"
        >
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionCloseBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnCaptionCloseBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionClosePressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The three window buttons as coloured dots. What each one does is drawn inside
             it only while the pointer is over the group, so at rest they are just colour. -->
        <Style x:Key="TrafficLightStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent so the whole 20x32 cell takes the click, not just the dot. -->
                        <Grid Background="Transparent">
                            <Ellipse
                                x:Name="Light"
                                Width="12"
                                Height="12"
                                Fill="{TemplateBinding Background}"
                            />
                            <Path
                                x:Name="Sign"
                                Width="12"
                                Height="12"
                                Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Stroke="#B3000000"
                                StrokeThickness="1.3"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                            />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger
                                Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                Value="True"
                            >
                                <Setter TargetName="Sign" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Light" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="RecentProjectStyle"
            TargetType="Button"
            BasedOn="{StaticResource ChromeButtonStyle}"
        >
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="TerminalSlotStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter
                Property="Background"
                Value="{DynamicResource TerminalBrush}"
            />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="VerticalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Width="1"
                                Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="27" />
            <Setter Property="Background" Value="{DynamicResource PaneHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="PanelToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ToggleSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                The icons are pre-tinted PNGs so an unchecked toggle can
                                dim without losing colour: accent when shown, muted when
                                hidden, bright on hover.
                            -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="0.42"
                                />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="1"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same pre-tinted icons the status bar uses, a size up for a list row. -->
        <Style x:Key="WelcomeIconStyle" TargetType="Image">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelIconStyle" TargetType="Image">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TitlePillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InteractiveBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="TitlePillTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBrush}">
        <!-- The window's own edge. Windows stops drawing one once the corners are
             squared, and without it the window has no outline against whatever is
             behind it. Drawn above everything and never hit-tested, so it costs the
             content one pixel and the resize grip nothing. When maximised it falls
             outside the screen along with the rest of the frame. -->
        <Border
            Panel.ZIndex="100"
            BorderBrush="{DynamicResource PressedBrush}"
            BorderThickness="1"
            IsHitTestVisible="False"
            SnapsToDevicePixels="True"
        />
        <Grid x:Name="MaximizeInset" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
            >
            <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                    >
                    <Button
                            x:Name="HomeButton"
                            Click="HomeButton_Click"
                            Style="{DynamicResource ChromeButtonStyle}"
                            Width="26"
                            Height="26"
                            Padding="1"
                            ToolTip="Command palette (Ctrl+P)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        >
                        <Image
                                Source="/src/Assets/helide.png"
                                Width="18"
                                Height="18"
                                RenderOptions.BitmapScalingMode="HighQuality"
                            />
                    </Button>
                    <!-- One strip in three segments: which project, where it is, which
                         branch. The name is the accent block because it is the one
                         thing that tells two Helide windows apart at a glance. -->
                    <Border
                            x:Name="ProjectNamePill"
                            Visibility="Collapsed"
                            Height="18"
                            Margin="8,0,0,0"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                        >
                        <TextBlock
                                x:Name="ProjectNamePillText"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                FontSize="{DynamicResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextOnAccentBrush}"
                            />
                    </Border>
                    <Border
                            x:Name="ProjectPathPill"
                            Visibility="Collapsed"
                            Height="18"
                            MaxWidth="460"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InteractiveBrush}"
                        >
                        <TextBlock
                                x:Name="ProjectPathPillText"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                FontSize="{DynamicResource FontSizeSmall}"
                                Foreground="{DynamicResource TextBrush}"
                                TextTrimming="CharacterEllipsis"
                            />
                    </Border>
                    <Border
                            x:Name="GitBranchPill"
                            Visibility="Collapsed"
                            Height="18"
                            Padding="8,0,9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PressedBrush}"
                        >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                    Source="/src/Assets/icons/git.png"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,6,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                />
                            <TextBlock
                                    x:Name="GitBranchPillText"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MauveBrush}"
                                />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                    <!-- Green, because it is the one pill that is asking for something. -->
                    <Border
                            x:Name="UpdatePill"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="UpdatePill_Click"
                            Cursor="Hand"
                            ToolTip="Update available. Click to install"
                            Height="18"
                            Padding="8,0,9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SuccessBrush}"
                        >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                    Text="&#xE896;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="10"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                />
                            <TextBlock
                                    x:Name="UpdatePillText"
                                    Text="Update available"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                />
                        </StackPanel>
                    </Border>
                    <!-- A panel of their own: the hover that reveals the signs is this
                         panel's, and it must not include the update pill beside it. -->
                    <StackPanel
                            Orientation="Horizontal"
                            Margin="10,0,10,0"
                            Background="Transparent"
                        >
                        <Button
                                Click="MinimizeCaptionButton_Click"
                                Style="{DynamicResource TrafficLightStyle}"
                                Background="#FEBC2E"
                                Tag="M3.5,6 H8.5"
                                ToolTip="Minimize"
                            />
                        <Button
                                Click="MaximizeRestoreCaptionButton_Click"
                                Style="{DynamicResource TrafficLightStyle}"
                                Background="#28C840"
                                Tag="M3.5,6 H8.5 M6,3.5 V8.5"
                                ToolTip="Maximize or restore"
                            />
                        <Button
                                Click="CloseCaptionButton_Click"
                                Style="{DynamicResource TrafficLightStyle}"
                                Background="#FF5F57"
                                Tag="M4,4 L8,8 M8,4 L4,8"
                                ToolTip="Close"
                            />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid
                    x:Name="WelcomeRoot"
                    Background="{DynamicResource WindowBrush}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                    >
                    <Grid MinHeight="650" Margin="48">
                        <StackPanel
                                Width="560"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            >
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                        Source="/src/Assets/helide.png"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                    />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                            Text="Helide"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextBrush}"
                                        />
                                    <TextBlock
                                            Text="Keep the editor you love. Bring the project tools you need."
                                            Margin="2,0,0,0"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                        />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                    Text="GET STARTED"
                                    Margin="1,0,0,7"
                                    Style="{DynamicResource SectionLabelStyle}"
                                />

                            <Button
                                    x:Name="OpenProjectButton"
                                    Click="OpenProjectButton_Click"
                                    Style="{DynamicResource WelcomeRowStyle}"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                            Source="/src/Assets/icons/open.png"
                                            Style="{DynamicResource WelcomeIconStyle}"
                                        />
                                    <TextBlock
                                            Grid.Column="1"
                                            Text="Open project folder"
                                            FontSize="{DynamicResource FontSizeLarge}"
                                            VerticalAlignment="Center"
                                        />
                                    <Border Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                                        <TextBlock Text="Ctrl+O" Style="{DynamicResource KeyBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button
                                    x:Name="ContinueProjectButton"
                                    Click="ContinueProjectButton_Click"
                                    Style="{DynamicResource WelcomeRowStyle}"
                                    Visibility="Collapsed"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                            Source="/src/Assets/icons/continue.png"
                                            Style="{DynamicResource WelcomeIconStyle}"
                                        />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                                Text="Continue last workspace"
                                                FontSize="{DynamicResource FontSizeLarge}"
                                            />
                                        <TextBlock
                                                x:Name="ContinueProjectPathText"
                                                Margin="0,1,0,0"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                                        <TextBlock Text="Enter" Style="{DynamicResource KeyBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <TextBlock
                                    Text="RECENT PROJECTS"
                                    Margin="1,16,0,7"
                                    Style="{DynamicResource SectionLabelStyle}"
                                />

                            <ItemsControl x:Name="RecentProjectItems" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                                Click="RecentProject_Click"
                                                Tag="{Binding Path}"
                                                Style="{DynamicResource WelcomeRowStyle}"
                                            >
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                        Source="/src/Assets/icons/folder.png"
                                                        Style="{DynamicResource WelcomeIconStyle}"
                                                    />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                            Text="{Binding Name}"
                                                            FontSize="{DynamicResource FontSizeLarge}"
                                                        />
                                                    <TextBlock
                                                            Text="{Binding Path}"
                                                            Margin="0,1,0,0"
                                                            Foreground="{DynamicResource TextSubtleBrush}"
                                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                                            FontSize="{DynamicResource FontSizeCaption}"
                                                            TextTrimming="CharacterEllipsis"
                                                        />
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                                                    <TextBlock Text="{Binding Shortcut}" Style="{DynamicResource KeyBadgeTextStyle}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                    x:Name="RecentEmptyText"
                                    Text="No recent projects yet."
                                    Margin="1,4,0,0"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Foreground="{DynamicResource TextSubtleBrush}"
                                />
                            <TextBlock
                                    x:Name="WelcomeStatus"
                                    Margin="1,14,0,0"
                                    Foreground="{DynamicResource TextFaintBrush}"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    TextWrapping="Wrap"
                                />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- The whole strip is the switch. Agents are optional, so this is where
                     they are turned on, and it sits apart from the project list because
                     it is a setting for the app rather than something to open. -->
                <ToggleButton
                        x:Name="AiBanner"
                        Grid.Row="1"
                        Click="AiBanner_Click"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                    >
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                    x:Name="BannerSurface"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="28,16"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                            x:Name="BannerIcon"
                                            Source="/src/Assets/icons/agent.png"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,16,0"
                                            Opacity="0.45"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                        />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                                Text="Enable AI"
                                                FontSize="{DynamicResource FontSizeLarge}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextBrush}"
                                            />
                                        <TextBlock
                                                Text="{TemplateBinding Content}"
                                                Margin="0,3,0,0"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                    </StackPanel>
                                    <TextBlock
                                            x:Name="BannerState"
                                            Grid.Column="2"
                                            Text="AI Disabled"
                                            Margin="16,0,14,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Foreground="{DynamicResource TextFaintBrush}"
                                        />
                                    <Border
                                            x:Name="BannerTrack"
                                            Grid.Column="3"
                                            Width="40"
                                            Height="20"
                                            CornerRadius="0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource InteractiveBrush}"
                                            BorderBrush="{DynamicResource PressedBrush}"
                                            BorderThickness="1"
                                        >
                                        <Border
                                                x:Name="BannerKnob"
                                                Width="14"
                                                Height="12"
                                                Margin="3,0"
                                                CornerRadius="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TextSubtleBrush}"
                                            />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BannerSurface" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BannerTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BannerState" Property="Text" Value="AI Enabled" />
                                    <Setter TargetName="BannerState" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BannerTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BannerTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BannerKnob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="BannerKnob" Property="Background" Value="{DynamicResource TextOnAccentBrush}" />
                                    <Setter TargetName="BannerIcon" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <Grid
                    x:Name="WorkspaceRoot"
                    Visibility="Collapsed"
                    Background="{DynamicResource TerminalBrush}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid
                        Grid.Row="0"
                        x:Name="PaneGrid"
                        Background="{DynamicResource TerminalBrush}"
                    >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                                x:Name="LeftPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                        <ColumnDefinition
                                x:Name="LeftSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="CenterPaneColumn"
                                Width="58*"
                                MinWidth="500"
                            />
                        <ColumnDefinition
                                x:Name="RightSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="RightPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="LeftPane"
                        Grid.Column="0"
                    >
                        <Grid.RowDefinitions><RowDefinition
                                    Height="27"
                                /><RowDefinition
                                    Height="*"
                                /></Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{DynamicResource PaneHeaderStyle}"
                            >
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Column="0"
                                        x:Name="LeftPaneTitle"
                                        Text="GIT"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Foreground="{DynamicResource TextPaneTitleBrush}"
                                    />
                                <TextBlock
                                        Grid.Column="1"
                                        x:Name="GitPaneState"
                                        Text="starting"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextIdleBrush}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                    />
                                <TextBlock
                                        Grid.Column="1"
                                        x:Name="ProjectPaneState"
                                        Text="starting"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextIdleBrush}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        Visibility="Collapsed"
                                    />
                            </Grid>
                        </Border>
                        <Grid
                                Grid.Row="1"
                                x:Name="LeftToolStack"
                                Background="{DynamicResource TerminalBrush}"
                            />
                    </Grid>

                    <GridSplitter
                            Grid.Column="1"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                    x:Name="EditorPaneRow"
                                    Height="80*"
                                    MinHeight="220"
                                />
                            <RowDefinition
                                    x:Name="RunnerSplitterRow"
                                    Height="3"
                                />
                            <RowDefinition
                                    x:Name="RunnerPaneRow"
                                    Height="20*"
                                    MinHeight="100"
                                />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{DynamicResource PaneHeaderStyle}"
                                >
                                <!-- A Grid rather than a DockPanel: the strip has to be the
                                     flexible element so it gives up width when the pane is
                                     narrow. Docked children are measured in order and each
                                     takes what it asks for, so a capped strip still pushed the
                                     + button and the state text off the right edge once the
                                     tab list grew. -->
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Grid.Column="0"
                                            Text="HELIX"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="{DynamicResource TextPaneTitleBrush}"
                                        />
                                    <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Margin="8,6"
                                            Background="{DynamicResource BorderBrush}"
                                            VerticalAlignment="Center"
                                        />
                                    <Border
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            Margin="9,0,4,0"
                                            Background="Transparent"
                                            ClipToBounds="True">
                                            <!-- The tab strip is clipped to the header row, so a
                                                 long list of tabs slides out of sight instead of
                                                 spilling down the pane. -->
                                            <ScrollViewer
                                                    x:Name="EditorTabStripScroll"
                                                    PreviewMouseWheel="TabStrip_MouseWheel"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Disabled"
                                                    Focusable="False"
                                            >
                                                <ItemsControl x:Name="EditorTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <Button
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                x:Name="EditorTabSplitButton"
                                                Width="22"
                                                Height="27"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                Click="EditorTabSplitButton_Click"
                                                Content="+"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="New empty editor tab"
                                        >
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                            x:Name="SplitSurface"
                                                            Background="{TemplateBinding Background}"
                                                            Width="22"
                                                            Height="27"
                                                    >
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SplitSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                </Grid>
                            </Border>
                            <Grid
                                    Grid.Row="1"
                                    x:Name="EditorSlot"
                                    Background="{DynamicResource TerminalBrush}"
                                />
                        </Grid>
                        <GridSplitter
                                Grid.Row="1"
                                Height="3"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource HorizontalSplitterStyle}"
                                DragCompleted="LayoutSplitter_DragCompleted"
                            />
                        <Grid
                                x:Name="RunnerPane"
                                Grid.Row="2"
                            >
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{DynamicResource PaneHeaderStyle}"
                                >
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Grid.Column="0"
                                            Text="RUN"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="{DynamicResource TextPaneTitleBrush}"
                                        />
                                    <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Margin="8,6"
                                            Background="{DynamicResource BorderBrush}"
                                            VerticalAlignment="Center"
                                        />
                                    <Border
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            Margin="9,0,4,0"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                        >
                                        <ScrollViewer
                                                x:Name="RunnerTabStripScroll"
                                                PreviewMouseWheel="TabStrip_MouseWheel"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Disabled"
                                                Focusable="False"
                                        >
                                            <ItemsControl x:Name="RunnerTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <Button
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            x:Name="RunnerNewSessionButton"
                                            Click="RunnerNewSessionButton_Click"
                                            ToolTip="New runner session"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="22"
                                            Height="27"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                            Cursor="Hand"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Content="+"
                                        >
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                        x:Name="SplitSurface"
                                                        Background="{TemplateBinding Background}"
                                                        Width="22"
                                                        Height="27"
                                                    >
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SplitSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <ContentControl
                                    Grid.Row="1"
                                    x:Name="RunnerSlot"
                                    Style="{DynamicResource TerminalSlotStyle}"
                                />
                        </Grid>
                    </Grid>

                    <GridSplitter
                            Grid.Column="3"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                        <Grid
                            x:Name="AgentPane"
                            Grid.Column="4"
                        >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" MinHeight="32" />
                            </Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{DynamicResource PaneHeaderStyle}"
                            >
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Title -->
                                <TextBlock
                                        Grid.Column="0"
                                        x:Name="AgentPaneTitle"
                                        Text="OPENCODE"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Foreground="{DynamicResource TextPaneTitleBrush}"
                                    />
                                <!-- Separator -->
                                <Border
                                        Grid.Column="1"
                                        Width="1"
                                        Margin="8,6"
                                        Background="{DynamicResource BorderBrush}"
                                        VerticalAlignment="Center"
                                    />
                                <!-- Session tab strip -->
                                <Border
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Height="27"
                                        Margin="9,0,4,0"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                    >
                                    <ScrollViewer
                                            x:Name="AgentTabStripScroll"
                                            PreviewMouseWheel="TabStrip_MouseWheel"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Disabled"
                                            Focusable="False"
                                    >
                                        <ItemsControl x:Name="AgentTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <!-- + icon -->
                                <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        x:Name="AgentNewSessionButton"
                                        Click="AgentNewSessionButton_Click"
                                        ToolTip="New agent session"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="22"
                                        Height="27"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Foreground="{DynamicResource TextSubtleBrush}"
                                        Cursor="Hand"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeMedium}"
                                        Content="+"
                                    >
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                    x:Name="SplitSurface"
                                                    Background="{TemplateBinding Background}"
                                                    Width="22"
                                                    Height="27"
                                                >
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SplitSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Flyout for new agent session -->
                        <Popup
                                x:Name="AgentNewSessionFlyout"
                                PlacementTarget="{Binding ElementName=AgentNewSessionButton}"
                                Placement="Bottom"
                                StaysOpen="False"
                                AllowsTransparency="True"
                            >
                            <!-- A menu, not a card: three short rows under the + that opened it. -->
                            <Border
                                    Background="{DynamicResource PopoverBrush}"
                                    BorderBrush="{DynamicResource PressedBrush}"
                                    BorderThickness="1"
                                    Padding="0,3"
                                    MinWidth="120"
                                >
                                <StackPanel>
                                    <Button
                                            x:Name="NewOpenCodeButton"
                                            Click="NewOpenCodeButton_Click"
                                            Style="{DynamicResource MenuRowStyle}"
                                            Content="OpenCode"
                                        />
                                    <Button
                                            x:Name="NewCodexButton"
                                            Click="NewCodexButton_Click"
                                            Style="{DynamicResource MenuRowStyle}"
                                            Content="Codex"
                                        />
                                    <Button
                                            x:Name="NewClaudeButton"
                                            Click="NewClaudeButton_Click"
                                            Style="{DynamicResource MenuRowStyle}"
                                            Content="Claude"
                                        />
                                    <!-- Shown instead of the rows when none of the agents is installed. -->
                                    <TextBlock
                                            x:Name="NoAgentsText"
                                            Text="No agent found on PATH.&#x0a;Install opencode, codex or claude."
                                            Visibility="Collapsed"
                                            Margin="10,4,10,4"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                        />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- Agent session content -->
                        <ContentControl
                                Grid.Row="1"
                                x:Name="AgentSlot"
                                Style="{DynamicResource TerminalSlotStyle}"
                            />
                    </Grid>
                </Grid>

                <Border
                        Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                    >
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="GitPanelToggle"
                                    Click="GitPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show git panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/git.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="ProjectPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="ProjectPanelToggle_Click"
                                    IsChecked="False"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show project panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/project.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                        </StackPanel>
                        <StackPanel
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="TerminalPanelToggle"
                                    Click="TerminalPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show terminal panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/terminal.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="AgentPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="AgentPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show agent panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/agent.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                         </StackPanel>
                     </Grid>
                 </Border>
              </Grid>
         </Grid>
         </Grid>


        <!-- A top-level Popup rather than an overlay inside the tree. Every pane is an
             HwndHost-backed terminal renderer, and WPF has no z-order authority over a
             child HWND: anything drawn in-tree would slide under the editor and agent
             panes. A Popup is a real layered window and sits above them. -->
        <Popup x:Name="CommandPalettePopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="CommandPalettePopup_Opened"
               PopupAnimation="None">
            <ui:CommandPalette x:Name="CommandPaletteControl" />
        </Popup>

        <!-- The same overlay pattern for the folder picker. A separate popup rather
             than a mode inside the palette: the palette's keyboard model is about
             running commands, and this one is about walking a tree. -->
        <Popup x:Name="FolderPickerPopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="FolderPickerPopup_Opened"
               PopupAnimation="None">
            <ui:FolderPicker x:Name="FolderPickerControl"
                             Picked="FolderPicker_Picked"
                             Dismissed="CloseFolderPicker" />
        </Popup>
    </Grid>
</Window>
