<Window
    x:Class="Helide.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:ui="clr-namespace:Helide.Shell"
    Title="Helide"
    Height="900"
    Width="1500"
    MinHeight="640"
    MinWidth="1050"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    Foreground="{DynamicResource TextBrush}"
    FontFamily="{DynamicResource UiFontFamily}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"
        />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Built-in, because the two visibilities are computed by the view models rather
             than combined here. FrameworkElement.Triggers accepts EventTrigger only, so
             a DataTrigger on the tab Border would throw as soon as a strip renders. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Zen mode's mark: the four corners of a frame around a single point. Drawn
             rather than taken from the icon font, whose nearest glyph is the generic
             full-screen arrows and says "bigger", not "only this". -->
        <DataTemplate x:Key="ZenIconTemplate">
            <Grid Width="14" Height="14">
                <Path
                    Data="M2,5 V2 H5 M9,2 H12 V5 M12,9 V12 H9 M5,12 H2 V9"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Square"
                    StrokeEndLineCap="Square"
                    SnapsToDevicePixels="True"
                />
                <Rectangle
                    Width="4"
                    Height="4"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                />
            </Grid>
        </DataTemplate>

        <!-- The x on a tab. Drawn rather than typed, so it sits on the pixel grid at this
             size instead of wherever the font's glyph happens to land. -->
        <Style x:Key="TabCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="{TemplateBinding Background}">
                            <Path
                                Data="M5.5,5.5 L12.5,12.5 M12.5,5.5 L5.5,12.5"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.2"
                                SnapsToDevicePixels="True"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One tab, for all three strips. The editor, runner and agent strips used to
             carry a copy each, and the copies had drifted: different widths, different
             close buttons, and three sets of handlers.

             Two borders on purpose. The inner one takes its fill from the view model,
             which is transparent for an inactive tab, so the outer one's hover colour
             shows through it; a single border could not do both, because a bound
             Background outranks a style trigger.

             The active tab is the colour of the pane beneath it and reaches one pixel
             over the header's bottom line, so it reads as part of the pane rather than
             as a button above it. -->
        <DataTemplate x:Key="PaneTabTemplate">
            <Border
                Margin="0,0,1,-1"
                Cursor="Hand"
                ToolTip="{Binding ToolTipText}"
                MouseEnter="Tab_MouseEnter"
                MouseLeave="Tab_MouseLeave"
                PreviewMouseLeftButtonDown="Tab_PointerDown"
                MouseMove="Tab_PointerMove"
                MouseLeftButtonUp="Tab_PointerUp"
                MouseRightButtonUp="Tab_ContextRequested"
                LostMouseCapture="Tab_LostCapture"
            >
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource InteractiveBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border
                    Background="{Binding Background}"
                    BorderBrush="{Binding Underline}"
                    BorderThickness="0,2,0,0"
                    Padding="10,0,4,2"
                >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding Name}"
                            FontFamily="{DynamicResource UiMonoFontFamily}"
                            FontSize="{DynamicResource FontSizeSmall}"
                            Foreground="{Binding Foreground}"
                            FontWeight="{Binding Weight}"
                            MaxWidth="150"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                        />
                        <Grid Width="18" Height="18" Margin="5,0,0,0">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Fill="{DynamicResource SuccessBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowAttentionDot, Converter={StaticResource BoolToVis}}"
                            />
                            <Button
                                Click="Tab_Close"
                                Style="{StaticResource TabCloseStyle}"
                                ToolTip="Close"
                                Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                            />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <!-- A row on the welcome screen: a box, and the pointer only lights its edge.
             Filling the whole box on hover made a list of them flash as the mouse
             crossed it. -->
        <Style x:Key="WelcomeRowStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Box"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                        >
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PressedStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in a small menu, such as the one that picks an agent. -->
        <Style x:Key="MenuRowStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0,14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RowSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2,0,0,0"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A square button for a pane's header strip: the + that adds a tab, and the git and
             project actions. Its content is a GlyphIcon, which draws the glyph small and
             heavier than the icon font does. As tall as the strip and flush with its edge, so
             it docks rather than floats. It never takes keyboard focus, so a click on it
             leaves the pane that had the cursor where it was. BorderBrush is the colour the
             glyph turns on hover, and is only borrowed for that: the template draws no border,
             and a template trigger has no other way to be given a value per button. -->
        <Style x:Key="PaneIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                        >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                <Setter Property="Foreground" Value="{Binding BorderBrush, RelativeSource={RelativeSource Self}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the title bar's project strip, as a button. The fill is the
             segment's own colour, set where it is used, and the pointer only lays a veil over
             it, so every segment keeps its colour and still reads as something to press. -->
        <Style x:Key="TitlePillStyle" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="Veil"
                                Background="{DynamicResource TextStrongBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"
                            />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Veil" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Veil" Property="Opacity" Value="0.24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource PressedBrush}"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The three window buttons as coloured dots. What each one does is drawn inside
             it only while the pointer is over the group, so at rest they are just colour. -->
        <Style x:Key="TrafficLightStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent so the whole 20x32 cell takes the click, not just the dot. -->
                        <Grid Background="Transparent">
                            <Ellipse
                                x:Name="Light"
                                Width="12"
                                Height="12"
                                Fill="{TemplateBinding Background}"
                            />
                            <Path
                                x:Name="Sign"
                                Width="12"
                                Height="12"
                                Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Stroke="#B3000000"
                                StrokeThickness="1.3"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                            />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger
                                Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                Value="True"
                            >
                                <Setter TargetName="Sign" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Light" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalSlotStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter
                Property="Background"
                Value="{DynamicResource TerminalBrush}"
            />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="VerticalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Width="1"
                                Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="27" />
            <Setter Property="Background" Value="{DynamicResource PaneHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="PanelToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ToggleSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                The icons are pre-tinted PNGs so an unchecked toggle can
                                dim without losing colour: accent when shown, muted when
                                hidden, bright on hover.
                            -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="0.42"
                                />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="1"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same pre-tinted icons the status bar uses, a size up for a list row. -->
        <Style x:Key="WelcomeIconStyle" TargetType="Image">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelIconStyle" TargetType="Image">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBrush}">
        <!-- The window's own edge. Windows stops drawing one once the corners are
             squared, and without it the window has no outline against whatever is
             behind it. Drawn above everything and never hit-tested, so it costs the
             content one pixel and the resize grip nothing. When maximised it falls
             outside the screen along with the rest of the frame. -->
        <Border
            Panel.ZIndex="100"
            BorderBrush="{DynamicResource PressedBrush}"
            BorderThickness="1"
            IsHitTestVisible="False"
            SnapsToDevicePixels="True"
        />
        <Grid x:Name="MaximizeInset" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- All that is left of the chrome in zen mode: a sliver along the top edge.
             Touching it opens the zen bar, which is a popup laid over the editor rather
             than a row above it, so the editor is not resized every time the pointer
             brushes the top of the screen. It has to be asked to take the mouse, because
             this strip of the window is otherwise caption. -->
        <Border
                x:Name="ZenReveal"
                Grid.Row="0"
                Height="4"
                Visibility="Collapsed"
                Background="{DynamicResource PaneHeaderBrush}"
                MouseEnter="ZenReveal_MouseEnter"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
            />

        <Border
                x:Name="TitleBar"
                Grid.Row="0"
                Height="32"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
            >
            <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                    >
                    <Button
                            x:Name="HomeButton"
                            Click="HomeButton_Click"
                            Style="{DynamicResource ChromeButtonStyle}"
                            Width="26"
                            Height="26"
                            Padding="1"
                            ToolTip="Command palette (Ctrl+P)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        >
                        <Image
                                Source="/src/Assets/helide.png"
                                Width="18"
                                Height="18"
                                RenderOptions.BitmapScalingMode="HighQuality"
                            />
                    </Button>
                    <!-- One strip in three segments: which project, where it is, which branch. Flat
                         and butted together, so it reads as one strip, with the colour of each
                         segment doing the dividing. The name is the accent block because it is the
                         one thing that tells two Helide windows apart at a glance. The name and the
                         branch are buttons (a project picker and a branch picker) and the path, which
                         has nothing to choose, is not. -->
                    <Button
                            x:Name="ProjectNamePill"
                            Style="{DynamicResource TitlePillStyle}"
                            Visibility="Collapsed"
                            Margin="8,0,0,0"
                            Background="{DynamicResource AccentBrush}"
                            Click="ProjectNamePill_Click"
                            ToolTip="Switch project"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        >
                        <TextBlock
                                x:Name="ProjectNamePillText"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                FontSize="{DynamicResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextOnAccentBrush}"
                            />
                    </Button>
                    <Border
                            x:Name="ProjectPathPill"
                            Visibility="Collapsed"
                            Height="18"
                            MaxWidth="460"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InteractiveBrush}"
                        >
                        <TextBlock
                                x:Name="ProjectPathPillText"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                FontSize="{DynamicResource FontSizeSmall}"
                                Foreground="{DynamicResource TextBrush}"
                                TextTrimming="CharacterEllipsis"
                            />
                    </Border>
                    <Button
                            x:Name="GitBranchPill"
                            Style="{DynamicResource TitlePillStyle}"
                            Visibility="Collapsed"
                            Padding="8,0,9,0"
                            Background="{DynamicResource PressedBrush}"
                            Click="GitBranchPill_Click"
                            ToolTip="Switch branch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                    Source="/src/Assets/icons/git.png"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,6,0"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                />
                            <TextBlock
                                    x:Name="GitBranchPillText"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MauveBrush}"
                                />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                    <!-- Green, because it is the one pill that is asking for something. -->
                    <Border
                            x:Name="UpdatePill"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="UpdatePill_Click"
                            Cursor="Hand"
                            ToolTip="Update available. Click to install"
                            Height="18"
                            Padding="8,0,9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SuccessBrush}"
                        >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                    x:Name="UpdatePillIcon"
                                    Text="&#xE896;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="10"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                >
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="UpdatePillSpin" Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock
                                    x:Name="UpdatePillText"
                                    Text="Update available"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                />
                        </StackPanel>
                    </Border>
                    <!-- Zen mode: every panel closed, and this bar and the editor's tab
                         strip with them. Only offered while a workspace is showing. -->
                    <ToggleButton
                            x:Name="ZenToggle"
                            Click="ZenToggle_Click"
                            Visibility="Collapsed"
                            Margin="12,0,6,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource PanelToggleStyle}"
                            ToolTip="Zen mode (F11)"
                            ContentTemplate="{StaticResource ZenIconTemplate}"
                        />
                    <!-- A panel of their own: the hover that reveals the signs is this
                         panel's, and it must not include the update pill beside it. -->
                    <StackPanel
                            Orientation="Horizontal"
                            Margin="10,0,10,0"
                            Background="Transparent"
                        >
                        <Button
                                Click="MinimizeCaptionButton_Click"
                                Style="{DynamicResource TrafficLightStyle}"
                                Background="#FEBC2E"
                                Tag="M3.5,6 H8.5"
                                ToolTip="Minimize"
                            />
                        <Button
                                Click="MaximizeRestoreCaptionButton_Click"
                                Style="{DynamicResource TrafficLightStyle}"
                                Background="#28C840"
                                Tag="M3.5,6 H8.5 M6,3.5 V8.5"
                                ToolTip="Maximize or restore"
                            />
                        <Button
                                Click="CloseCaptionButton_Click"
                                Style="{DynamicResource TrafficLightStyle}"
                                Background="#FF5F57"
                                Tag="M4,4 L8,8 M8,4 L4,8"
                                ToolTip="Close"
                            />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid
                    x:Name="WelcomeRoot"
                    Background="{DynamicResource WindowBrush}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                    >
                    <Grid MinHeight="650" Margin="48">
                        <StackPanel
                                Width="560"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            >
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                        Source="/src/Assets/helide.png"
                                        Width="60"
                                        Height="60"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                    />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                            Text="Helide"
                                            FontSize="36"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextBrush}"
                                        />
                                    <TextBlock
                                            Text="Keep the editor you love. Bring the project tools you need."
                                            Margin="2,0,0,0"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                        />
                                </StackPanel>
                            </Grid>

                            <!-- Only exists while a tool the panes need is missing. It sits above
                                 everything else on purpose: a project opened without it gets a
                                 pane that cannot start, so this is the thing to read first. The
                                 bar is the danger colour and nothing else about it is loud. -->
                            <Border
                                    x:Name="ToolNotice"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,26"
                                    Padding="14,12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="3,0,0,0"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                                x:Name="ToolNoticeTitle"
                                                FontSize="{DynamicResource FontSizeLarge}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextBrush}"
                                                TextWrapping="Wrap"
                                            />
                                        <TextBlock
                                                x:Name="ToolNoticeDetail"
                                                Margin="0,3,0,0"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                TextWrapping="Wrap"
                                            />
                                    </StackPanel>
                                    <Button
                                            x:Name="ToolInstallButton"
                                            Grid.Column="1"
                                            Margin="18,0,0,0"
                                            Padding="14,7"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Click="ToolInstallButton_Click"
                                            FocusVisualStyle="{x:Null}"
                                            Foreground="{DynamicResource TextBrush}"
                                        >
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                        x:Name="Box"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}"
                                                    >
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PressedStrongBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock
                                    Text="GET STARTED"
                                    Margin="1,0,0,7"
                                    Style="{DynamicResource SectionLabelStyle}"
                                />

                            <Button
                                    x:Name="OpenProjectButton"
                                    Click="OpenProjectButton_Click"
                                    Style="{DynamicResource WelcomeRowStyle}"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                            Source="/src/Assets/icons/open.png"
                                            Style="{DynamicResource WelcomeIconStyle}"
                                        />
                                    <TextBlock
                                            Grid.Column="1"
                                            Text="Open project folder"
                                            FontSize="{DynamicResource FontSizeLarge}"
                                            VerticalAlignment="Center"
                                        />
                                    <Border Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                                        <TextBlock Text="Ctrl+O" Style="{DynamicResource KeyBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button
                                    x:Name="ContinueProjectButton"
                                    Click="ContinueProjectButton_Click"
                                    Style="{DynamicResource WelcomeRowStyle}"
                                    Visibility="Collapsed"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                            Source="/src/Assets/icons/continue.png"
                                            Style="{DynamicResource WelcomeIconStyle}"
                                        />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                                Text="Continue last workspace"
                                                FontSize="{DynamicResource FontSizeLarge}"
                                            />
                                        <TextBlock
                                                x:Name="ContinueProjectPathText"
                                                Margin="0,1,0,0"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeCaption}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                                        <TextBlock Text="Enter" Style="{DynamicResource KeyBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <TextBlock
                                    Text="RECENT PROJECTS"
                                    Margin="1,16,0,7"
                                    Style="{DynamicResource SectionLabelStyle}"
                                />

                            <ItemsControl x:Name="RecentProjectItems" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                                Click="RecentProject_Click"
                                                Tag="{Binding Path}"
                                                Style="{DynamicResource WelcomeRowStyle}"
                                            >
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                        Source="/src/Assets/icons/folder.png"
                                                        Style="{DynamicResource WelcomeIconStyle}"
                                                    />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                            Text="{Binding Name}"
                                                            FontSize="{DynamicResource FontSizeLarge}"
                                                        />
                                                    <TextBlock
                                                            Text="{Binding Path}"
                                                            Margin="0,1,0,0"
                                                            Foreground="{DynamicResource TextSubtleBrush}"
                                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                                            FontSize="{DynamicResource FontSizeCaption}"
                                                            TextTrimming="CharacterEllipsis"
                                                        />
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                                                    <TextBlock Text="{Binding Shortcut}" Style="{DynamicResource KeyBadgeTextStyle}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                    x:Name="RecentEmptyText"
                                    Text="No recent projects yet."
                                    Margin="1,4,0,0"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Foreground="{DynamicResource TextSubtleBrush}"
                                />
                            <!-- What the panes need, marked as found. It stays a plain line when
                                 everything is there; the action only exists while something
                                 is missing, and is text rather than a button. -->
                            <TextBlock
                                    Text="TOOLS"
                                    Margin="1,22,0,7"
                                    Style="{DynamicResource SectionLabelStyle}"
                                />
                            <TextBlock
                                    x:Name="ToolStatusText"
                                    Margin="1,0,0,0"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Foreground="{DynamicResource TextSubtleBrush}"
                                    TextWrapping="Wrap"
                                />
                            <TextBlock
                                    x:Name="WelcomeStatus"
                                    Margin="1,14,0,0"
                                    Foreground="{DynamicResource TextFaintBrush}"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    TextWrapping="Wrap"
                                />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- The whole strip is the switch. Agents are optional, so this is where
                     they are turned on, and it sits apart from the project list because
                     it is a setting for the app rather than something to open. -->
                <ToggleButton
                        x:Name="AiBanner"
                        Grid.Row="1"
                        Click="AiBanner_Click"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                    >
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                    x:Name="BannerSurface"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="28,16"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                            x:Name="BannerIcon"
                                            Source="/src/Assets/icons/agent.png"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,16,0"
                                            Opacity="0.45"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                        />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                                Text="Enable AI"
                                                FontSize="{DynamicResource FontSizeLarge}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextBrush}"
                                            />
                                        <TextBlock
                                                Text="{TemplateBinding Content}"
                                                Margin="0,3,0,0"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                    </StackPanel>
                                    <TextBlock
                                            x:Name="BannerState"
                                            Grid.Column="2"
                                            Text="AI Disabled"
                                            Margin="16,0,14,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Foreground="{DynamicResource TextFaintBrush}"
                                        />
                                    <Border
                                            x:Name="BannerTrack"
                                            Grid.Column="3"
                                            Width="40"
                                            Height="20"
                                            CornerRadius="0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource InteractiveBrush}"
                                            BorderBrush="{DynamicResource PressedBrush}"
                                            BorderThickness="1"
                                        >
                                        <Border
                                                x:Name="BannerKnob"
                                                Width="14"
                                                Height="12"
                                                Margin="3,0"
                                                CornerRadius="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TextSubtleBrush}"
                                            />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BannerSurface" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="BannerTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BannerState" Property="Text" Value="AI Enabled" />
                                    <Setter TargetName="BannerState" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BannerTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BannerTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="BannerKnob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="BannerKnob" Property="Background" Value="{DynamicResource TextOnAccentBrush}" />
                                    <Setter TargetName="BannerIcon" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <Grid
                    x:Name="WorkspaceRoot"
                    Visibility="Collapsed"
                    Background="{DynamicResource TerminalBrush}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition x:Name="StatusBarRow" Height="28" />
                </Grid.RowDefinitions>

                <Grid
                        Grid.Row="0"
                        x:Name="PaneGrid"
                        Background="{DynamicResource TerminalBrush}"
                    >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                                x:Name="LeftPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                        <ColumnDefinition
                                x:Name="LeftSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="CenterPaneColumn"
                                Width="58*"
                                MinWidth="500"
                            />
                        <ColumnDefinition
                                x:Name="RightSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="RightPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="LeftPane"
                        Grid.Column="0"
                    >
                        <Grid.RowDefinitions><RowDefinition
                                    Height="27"
                                /><RowDefinition
                                    Height="*"
                                /></Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{DynamicResource PaneHeaderStyle}"
                            >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The git tool's origin commands. They run git in the project rather than
                                     typing into lazygit, whose keys mean whatever its current panel says. -->
                                <StackPanel x:Name="GitToolStrip" Grid.Column="0" Orientation="Horizontal">
                                    <Button
                                            x:Name="GitFetchButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="GitFetchButton_Click"
                                            ToolTip="Fetch all remotes"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE895;" />
                                    </Button>
                                    <Button
                                            x:Name="GitPullButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="GitPullButton_Click"
                                            ToolTip="Pull"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE896;" />
                                    </Button>
                                    <Button
                                            x:Name="GitPushButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="GitPushButton_Click"
                                            ToolTip="Push"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE898;" />
                                    </Button>
                                    <Button
                                            x:Name="GitForcePushButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            Click="GitForcePushButton_Click"
                                            ToolTip="Force push (--force-with-lease)"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE945;" />
                                    </Button>
                                    <Border
                                            Width="1"
                                            Height="14"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource PressedBrush}"
                                        />
                                    <Button
                                            x:Name="GitOpenRemoteButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="GitOpenRemoteButton_Click"
                                            ToolTip="Open the remote in the browser"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE774;" />
                                    </Button>
                                    <Button
                                            x:Name="GitCopyBranchButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="GitCopyBranchButton_Click"
                                            ToolTip="Copy branch name"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE8C8;" />
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="ProjectToolStrip" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button
                                            x:Name="ProjectNewFileButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="ProjectNewFileButton_Click"
                                            ToolTip="New file in the project root"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE7C3;" />
                                    </Button>
                                    <Button
                                            x:Name="ProjectNewFolderButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="ProjectNewFolderButton_Click"
                                            ToolTip="New folder in the project root"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE8F4;" />
                                    </Button>
                                    <Border
                                            Width="1"
                                            Height="14"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource PressedBrush}"
                                        />
                                    <Button
                                            x:Name="ProjectRootButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="ProjectRootButton_Click"
                                            ToolTip="Back to project root"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE80F;" />
                                    </Button>
                                    <Button
                                            x:Name="ProjectRevealButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="ProjectRevealButton_Click"
                                            ToolTip="Show in File Explorer"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE838;" />
                                    </Button>
                                    <Button
                                            x:Name="ProjectCopyPathButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="ProjectCopyPathButton_Click"
                                            ToolTip="Copy project path"
                                        >
                                        <ui:GlyphIcon Glyph="&#xE8C8;" />
                                    </Button>
                                </StackPanel>
                                <!-- What fills the rest of the strip: where the branch stands, or what the project
                                     root holds. Quiet, and it gives way to the buttons when the pane is narrow. -->
                                <TextBlock
                                        x:Name="GitStatusText"
                                        Grid.Column="1"
                                        Margin="10,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        Foreground="{DynamicResource TextFaintBrush}"
                                    />
                                <TextBlock
                                        x:Name="ProjectInfoText"
                                        Grid.Column="1"
                                        Margin="10,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        Foreground="{DynamicResource TextFaintBrush}"
                                        Visibility="Collapsed"
                                    />
                            </Grid>
                        </Border>
                        <Grid
                                Grid.Row="1"
                                x:Name="LeftToolStack"
                                Background="{DynamicResource TerminalBrush}"
                            />
                    </Grid>

                    <GridSplitter
                            x:Name="LeftSplitter"
                            Grid.Column="1"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                    <Grid x:Name="CenterPane" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                    x:Name="EditorPaneRow"
                                    Height="80*"
                                    MinHeight="220"
                                />
                            <RowDefinition
                                    x:Name="RunnerSplitterRow"
                                    Height="3"
                                />
                            <RowDefinition
                                    x:Name="RunnerPaneRow"
                                    Height="20*"
                                    MinHeight="100"
                                />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions><RowDefinition
                                        x:Name="EditorHeaderRow" Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    x:Name="EditorHeader" Grid.Row="0"
                                    Style="{DynamicResource PaneHeaderStyle}"
                                >
                                <!-- A Grid rather than a DockPanel: the strip has to be the
                                     flexible element so it gives up width when the pane is
                                     narrow. Docked children are measured in order and each
                                     takes what it asks for, so a capped strip still pushed the
                                     + button off the right edge once the
                                     tab list grew. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                            Grid.Column="0"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                        >
                                        <!-- The tab strip is clipped to the header row, so a
                                             long list of tabs slides out of sight instead of
                                             spilling down the pane. -->
                                        <ScrollViewer
                                                x:Name="EditorTabStripScroll"
                                                PreviewMouseWheel="TabStrip_MouseWheel"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Disabled"
                                                Focusable="False"
                                        >
                                            <ItemsControl x:Name="EditorTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <Button
                                            Grid.Column="1"
                                            x:Name="EditorTabSplitButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="EditorTabSplitButton_Click"
                                            ToolTip="New empty editor tab"
                                        >
                                            <ui:GlyphIcon Glyph="&#xE710;" />
                                        </Button>
                                </Grid>
                            </Border>
                            <ui:PaneSplitPanel
                                    Grid.Row="1"
                                    x:Name="EditorSlot"
                                    Background="{DynamicResource TerminalBrush}"
                                />
                        </Grid>
                        <GridSplitter
                                Grid.Row="1"
                                Height="3"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource HorizontalSplitterStyle}"
                                DragCompleted="LayoutSplitter_DragCompleted"
                            />
                        <Grid
                                x:Name="RunnerPane"
                                Grid.Row="2"
                            >
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{DynamicResource PaneHeaderStyle}"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                            Grid.Column="0"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                        >
                                        <ScrollViewer
                                                x:Name="RunnerTabStripScroll"
                                                PreviewMouseWheel="TabStrip_MouseWheel"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Disabled"
                                                Focusable="False"
                                        >
                                            <ItemsControl x:Name="RunnerTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <Button
                                            Grid.Column="1"
                                            x:Name="RunnerNewSessionButton"
                                            Style="{DynamicResource PaneIconButtonStyle}"
                                            Click="RunnerNewSessionButton_Click"
                                            ToolTip="New runner session"
                                        >
                                            <ui:GlyphIcon Glyph="&#xE710;" />
                                        </Button>
                                </Grid>
                            </Border>
                            <ui:PaneSplitPanel
                                    Grid.Row="1"
                                    x:Name="RunnerSlot"
                                    Background="{DynamicResource TerminalBrush}"
                                />
                        </Grid>
                    </Grid>

                    <GridSplitter
                            x:Name="RightSplitter"
                            Grid.Column="3"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                        <Grid
                            x:Name="AgentPane"
                            Grid.Column="4"
                        >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{DynamicResource PaneHeaderStyle}"
                            >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Session tab strip. It starts at the pane's own edge; there is no title in front of it. -->
                                <Border
                                        Grid.Column="0"
                                        VerticalAlignment="Stretch"
                                        Height="27"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                    >
                                    <ScrollViewer
                                            x:Name="AgentTabStripScroll"
                                            PreviewMouseWheel="TabStrip_MouseWheel"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Disabled"
                                            Focusable="False"
                                    >
                                        <ItemsControl x:Name="AgentTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <!-- + icon, docked to the right edge -->
                                <Button
                                        Grid.Column="1"
                                        x:Name="AgentNewSessionButton"
                                        Style="{DynamicResource PaneIconButtonStyle}"
                                        Click="AgentNewSessionButton_Click"
                                        ToolTip="New agent session"
                                    >
                                        <ui:GlyphIcon Glyph="&#xE710;" />
                                    </Button>
                            </Grid>
                        </Border>
                        <!-- Flyout for new agent session -->
                        <Popup
                                x:Name="AgentNewSessionFlyout"
                                PlacementTarget="{Binding ElementName=AgentNewSessionButton}"
                                Placement="Bottom"
                                StaysOpen="False"
                                AllowsTransparency="True"
                            >
                            <!-- A menu, not a card: three short rows under the + that opened it. -->
                            <Border
                                    Background="{DynamicResource PopoverBrush}"
                                    BorderBrush="{DynamicResource PressedBrush}"
                                    BorderThickness="1"
                                    Padding="0,3"
                                    MinWidth="120"
                                >
                                <StackPanel>
                                    <Button
                                            x:Name="NewOpenCodeButton"
                                            Click="NewOpenCodeButton_Click"
                                            Style="{DynamicResource MenuRowStyle}"
                                            Content="OpenCode"
                                        />
                                    <Button
                                            x:Name="NewCodexButton"
                                            Click="NewCodexButton_Click"
                                            Style="{DynamicResource MenuRowStyle}"
                                            Content="Codex"
                                        />
                                    <Button
                                            x:Name="NewClaudeButton"
                                            Click="NewClaudeButton_Click"
                                            Style="{DynamicResource MenuRowStyle}"
                                            Content="Claude"
                                        />
                                    <!-- Shown instead of the rows when none of the agents is installed. -->
                                    <TextBlock
                                            x:Name="NoAgentsText"
                                            Text="No agent found on PATH.&#x0a;Install opencode, codex or claude."
                                            Visibility="Collapsed"
                                            Margin="10,4,10,4"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                        />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- Agent session content -->
                        <ContentControl
                                Grid.Row="1"
                                x:Name="AgentSlot"
                                Style="{DynamicResource TerminalSlotStyle}"
                            />
                    </Grid>
                </Grid>

                <Border
                        x:Name="StatusBar"
                        Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                    >
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                                x:Name="StatusLeftGroup"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="GitPanelToggle"
                                    Click="GitPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show git panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/git.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="ProjectPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="ProjectPanelToggle_Click"
                                    IsChecked="False"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show project panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/project.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                        </StackPanel>
                        <StackPanel
                                x:Name="StatusRightGroup"
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="TerminalPanelToggle"
                                    Click="TerminalPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show terminal panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/terminal.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="AgentPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="AgentPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show agent panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/agent.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                         </StackPanel>
                     </Grid>
                 </Border>
              </Grid>
         </Grid>
         </Grid>


        <!-- A top-level Popup rather than an overlay inside the tree. Every pane is an
             HwndHost-backed terminal renderer, and WPF has no z-order authority over a
             child HWND: anything drawn in-tree would slide under the editor and agent
             panes. A Popup is a real layered window and sits above them. -->
        <!-- The zen bar. In zen mode the title bar and the editor's tab strip are both
             gone, and this is what the top edge brings back: the tabs, the way out of
             zen, and the window buttons, in one strip over the editor. A popup for the
             same reason as the palette below, and because laying it over the editor is
             the point: a bar that pushed the editor down would reflow the terminal on
             every reveal. -->
        <!-- What a right click on an editor or runner tab offers. A popup for the same
             reason as everything else here that has to sit above a pane. The rows are
             the same ones the new-agent menu uses. -->
        <Popup
                x:Name="TabSplitFlyout"
                Placement="Bottom"
                StaysOpen="False"
                AllowsTransparency="True"
            >
            <Border
                    Background="{DynamicResource PopoverBrush}"
                    BorderBrush="{DynamicResource PressedBrush}"
                    BorderThickness="1"
                    Padding="0,3"
                    MinWidth="150"
                >
                <StackPanel>
                    <Button
                            Tag="Right"
                            Click="TabSplit_Click"
                            Style="{DynamicResource MenuRowStyle}"
                            Content="Split Right"
                        />
                    <Button
                            Tag="Down"
                            Click="TabSplit_Click"
                            Style="{DynamicResource MenuRowStyle}"
                            Content="Split Down"
                        />
                    <Button
                            Tag="Left"
                            Click="TabSplit_Click"
                            Style="{DynamicResource MenuRowStyle}"
                            Content="Split Left"
                        />
                    <Button
                            Tag="Up"
                            Click="TabSplit_Click"
                            Style="{DynamicResource MenuRowStyle}"
                            Content="Split Up"
                        />
                    <Button
                            x:Name="TabUnsplitRow"
                            Tag="Unsplit"
                            Click="TabSplit_Click"
                            Style="{DynamicResource MenuRowStyle}"
                            Content="Close Split"
                        />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ZenBarPopup"
               Placement="Relative"
               AllowsTransparency="False"
               Focusable="False"
               StaysOpen="True"
               PopupAnimation="None">
            <Border
                    x:Name="ZenBar"
                    Height="32"
                    Background="{DynamicResource PaneHeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeave="ZenBar_MouseLeave"
                    TextElement.FontFamily="{DynamicResource UiFontFamily}"
                    TextElement.Foreground="{DynamicResource TextBrush}"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True"
                >
                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                            Click="HomeButton_Click"
                            Style="{DynamicResource ChromeButtonStyle}"
                            Width="26"
                            Height="26"
                            Padding="1"
                            VerticalAlignment="Center"
                            ToolTip="Command palette (Ctrl+P)"
                        >
                        <Image
                                Source="/src/Assets/helide.png"
                                Width="18"
                                Height="18"
                                RenderOptions.BitmapScalingMode="HighQuality"
                            />
                    </Button>
                    <!-- The editor's tabs: the same list and the same template as the
                         strip in the editor's header, which zen mode has folded away. -->
                    <!-- The same three segments the title bar carries, in the same place,
                         so the bar reads as the title bar with tabs added rather than
                         as something else. Filled in from the real ones each time the
                         bar opens. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border
                                Height="18"
                                Margin="8,0,0,0"
                                Padding="9,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                            >
                            <TextBlock
                                    x:Name="ZenNameText"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                />
                        </Border>
                        <Border
                                Height="18"
                                MaxWidth="460"
                                Padding="9,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource InteractiveBrush}"
                            >
                            <TextBlock
                                    x:Name="ZenPathText"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Foreground="{DynamicResource TextBrush}"
                                    TextTrimming="CharacterEllipsis"
                                />
                        </Border>
                        <Border
                                x:Name="ZenBranchPill"
                                Height="18"
                                Padding="8,0,9,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PressedBrush}"
                            >
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image
                                        Source="/src/Assets/icons/git.png"
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,6,0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                    />
                                <TextBlock
                                        x:Name="ZenBranchText"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource MauveBrush}"
                                    />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ScrollViewer
                            Grid.Column="2"
                            Margin="12,0,4,0"
                            PreviewMouseWheel="TabStrip_MouseWheel"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            Focusable="False"
                        >
                        <ItemsControl x:Name="ZenTabStrip" ItemTemplate="{StaticResource PaneTabTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button
                            Grid.Column="3"
                            Click="EditorTabSplitButton_Click"
                            Style="{DynamicResource ChromeButtonStyle}"
                            Width="24"
                            Height="26"
                            Padding="0"
                            VerticalAlignment="Center"
                            Content="+"
                            FontFamily="{DynamicResource UiMonoFontFamily}"
                            FontSize="{DynamicResource FontSizeMedium}"
                            ToolTip="New empty editor tab"
                        />
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <ToggleButton
                                Click="ZenToggle_Click"
                                IsChecked="True"
                                Margin="10,0,6,0"
                                VerticalAlignment="Center"
                                Style="{DynamicResource PanelToggleStyle}"
                                ToolTip="Leave zen mode (F11)"
                                ContentTemplate="{StaticResource ZenIconTemplate}"
                            />
                        <StackPanel
                                Orientation="Horizontal"
                                Margin="10,0,10,0"
                                Background="Transparent"
                            >
                            <Button
                                    Click="MinimizeCaptionButton_Click"
                                    Style="{DynamicResource TrafficLightStyle}"
                                    Background="#FEBC2E"
                                    Tag="M3.5,6 H8.5"
                                    ToolTip="Minimize"
                                />
                            <Button
                                    Click="ZenToggle_Click"
                                    Style="{DynamicResource TrafficLightStyle}"
                                    Background="#28C840"
                                    Tag="M3.5,6 H8.5 M6,3.5 V8.5"
                                    ToolTip="Leave zen mode"
                                />
                            <Button
                                    Click="CloseCaptionButton_Click"
                                    Style="{DynamicResource TrafficLightStyle}"
                                    Background="#FF5F57"
                                    Tag="M4,4 L8,8 M8,4 L4,8"
                                    ToolTip="Close"
                                />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Every message, confirmation and prompt for a name. A popup for the reason the
             palette is one, and a separate one so it can be raised while the palette's list is
             closing. -->
        <Popup x:Name="DialogPopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="DialogPopup_Opened"
               PopupAnimation="None">
            <ui:AppDialog x:Name="DialogControl" />
        </Popup>

        <Popup x:Name="CommandPalettePopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="CommandPalettePopup_Opened"
               PopupAnimation="None">
            <ui:CommandPalette x:Name="CommandPaletteControl" />
        </Popup>

        <!-- The same overlay pattern for the folder picker. A separate popup rather
             than a mode inside the palette: the palette's keyboard model is about
             running commands, and this one is about walking a tree. -->
        <Popup x:Name="FolderPickerPopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="FolderPickerPopup_Opened"
               PopupAnimation="None">
            <ui:FolderPicker x:Name="FolderPickerControl"
                             Picked="FolderPicker_Picked"
                             Dismissed="CloseFolderPicker" />
        </Popup>
    </Grid>
</Window>
