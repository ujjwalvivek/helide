<Window
    x:Class="Helide.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:ui="clr-namespace:Helide.Shell"
    Title="Helide"
    Height="900"
    Width="1500"
    MinHeight="640"
    MinWidth="1050"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    Foreground="{DynamicResource TextBrush}"
    FontFamily="{DynamicResource UiFontFamily}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="4"
            UseAeroCaptionButtons="False"
        />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Built-in, because the two visibilities are computed by the view models rather
             than combined here. FrameworkElement.Triggers accepts EventTrigger only, so
             a DataTrigger on the tab Border would throw as soon as a strip renders. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource PressedBrush}"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="WelcomeActionStyle"
            TargetType="Button"
            BasedOn="{StaticResource ChromeButtonStyle}"
        >
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CaptionSurface"
                            Background="{TemplateBinding Background}"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="CaptionSurface"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="CaptionSurface"
                                    Property="Background"
                                    Value="{DynamicResource PressedBrush}"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CloseCaptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource CaptionButtonStyle}"
        >
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionCloseBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnCaptionCloseBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionClosePressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="RecentProjectStyle"
            TargetType="Button"
            BasedOn="{StaticResource ChromeButtonStyle}"
        >
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <Style x:Key="TerminalSlotStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter
                Property="Background"
                Value="{DynamicResource TerminalBrush}"
            />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="VerticalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Width="1"
                                Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                Height="1"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="27" />
            <Setter Property="Background" Value="{DynamicResource PaneHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="2,2,0,0" />
        </Style>

        <Style x:Key="PanelToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ToggleSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                        >
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True"
                            />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                The icons are pre-tinted PNGs so an unchecked toggle can
                                dim without losing colour: accent when shown, muted when
                                hidden, bright on hover.
                            -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="0.42"
                                />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Background"
                                    Value="{DynamicResource InteractiveBrush}"
                                />
                                <Setter
                                    TargetName="ToggleSurface"
                                    Property="Opacity"
                                    Value="1"
                                />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelIconStyle" TargetType="Image">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TitlePillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InteractiveBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="TitlePillTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBrush}">
        <Grid x:Name="MaximizeInset" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
            >
            <Grid Margin="8,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                    >
                    <Button
                            x:Name="HomeButton"
                            Click="HomeButton_Click"
                            Style="{DynamicResource ChromeButtonStyle}"
                            Width="26"
                            Height="26"
                            Padding="1"
                            ToolTip="Command palette (Ctrl+P)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        >
                        <Image
                                Source="/src/Assets/helide.png"
                                Width="18"
                                Height="18"
                                RenderOptions.BitmapScalingMode="HighQuality"
                            />
                    </Button>
                    <Border x:Name="ProjectNamePill" Style="{DynamicResource TitlePillStyle}" Visibility="Collapsed">
                        <TextBlock
                                x:Name="ProjectNamePillText"
                                Style="{DynamicResource TitlePillTextStyle}"
                            />
                    </Border>
                    <Border x:Name="ProjectPathPill" Style="{DynamicResource TitlePillStyle}" Visibility="Collapsed">
                        <TextBlock
                                x:Name="ProjectPathPillText"
                                Style="{DynamicResource TitlePillTextStyle}"
                            />
                    </Border>
                    <Border x:Name="GitBranchPill" Style="{DynamicResource TitlePillStyle}" Visibility="Collapsed">
                        <TextBlock
                                x:Name="GitBranchPillText"
                                Style="{DynamicResource TitlePillTextStyle}"
                            />
                    </Border>
                </StackPanel>

                <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    >
                    <Border x:Name="UpdatePill" Style="{DynamicResource TitlePillStyle}" Visibility="Collapsed" MouseLeftButtonUp="UpdatePill_Click" Cursor="Hand" ToolTip="Update available — click to install">
                        <TextBlock x:Name="UpdatePillText" Style="{DynamicResource TitlePillTextStyle}" Text="Update available" />
                    </Border>
                    <Button
                            Click="MinimizeCaptionButton_Click"
                            Style="{DynamicResource CaptionButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                        />
                    <Button
                            Click="MaximizeRestoreCaptionButton_Click"
                            Style="{DynamicResource CaptionButtonStyle}"
                            ToolTip="Maximize or restore"
                        >
                        <TextBlock FontFamily="Segoe Fluent Icons">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger
                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="Maximized"
                                            >
                                            <Setter
                                                    Property="Text"
                                                    Value="&#xE923;"
                                                />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button
                            Click="CloseCaptionButton_Click"
                            Style="{DynamicResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                        />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid
                    x:Name="WelcomeRoot"
                    Background="{DynamicResource WindowBrush}"
                >
                <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                    >
                    <Grid MinHeight="650" Margin="48">
                        <StackPanel
                                Width="680"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            >
                            <StackPanel
                                    Orientation="Horizontal"
                                    Margin="10,0,10,28"
                                >
                                <Border
                                        Width="60"
                                        Height="60"
                                        CornerRadius="4"
                                        Margin="0,0,18,0"
                                        Background="Transparent"
                                    >
                                    <Image
                                            Source="/src/Assets/helide.png"
                                            Width="60"
                                            Height="60"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                        />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                            Text="Helide"
                                            FontSize="{DynamicResource FontSizeTitle}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextBrush}"
                                        />
                                    <TextBlock
                                            Text="Keep the editor you love. Bring the project tools you need."
                                            Margin="0,4,0,0"
                                            FontSize="{DynamicResource FontSizeLarge}"
                                            FontStyle="Italic"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                        />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                    Text="GET STARTED"
                                    Margin="0,0,0,7"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{DynamicResource TextFaintBrush}"
                                />
                            <Border
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                />

                            <Button
                                    x:Name="OpenProjectButton"
                                    Click="OpenProjectButton_Click"
                                    Style="{DynamicResource WelcomeActionStyle}"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Text="+"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                        />
                                    <TextBlock
                                            Grid.Column="1"
                                            Text="Open project folder"
                                        />
                                    <TextBlock
                                            Grid.Column="2"
                                            Text="Ctrl+O"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                        />
                                </Grid>
                            </Button>

                            <Button
                                    x:Name="ContinueProjectButton"
                                    Click="ContinueProjectButton_Click"
                                    Style="{DynamicResource WelcomeActionStyle}"
                                    Visibility="Collapsed"
                                >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Text="↻"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                        />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                                Text="Continue last workspace"
                                            />
                                        <TextBlock
                                                x:Name="ContinueProjectPathText"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                    </StackPanel>
                                    <TextBlock
                                            Grid.Column="2"
                                            Text="Enter"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                        />
                                </Grid>
                            </Button>

                            <TextBlock
                                    Text="RECENT PROJECTS"
                                    Margin="0,22,0,7"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Foreground="{DynamicResource TextFaintBrush}"
                                />
                            <Border
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                />

                            <ItemsControl x:Name="RecentProjectItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                                Click="RecentProject_Click"
                                                Tag="{Binding Path}"
                                                Style="{DynamicResource RecentProjectStyle}"
                                            >
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
                                                            Width="28"
                                                        />
                                                    <ColumnDefinition
                                                            Width="*"
                                                        />
                                                    <ColumnDefinition
                                                            Width="Auto"
                                                        />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                        Text="▱"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        FontSize="{DynamicResource FontSizeMedium}"
                                                    />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                            Text="{Binding Name}"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            FontSize="{DynamicResource FontSizeMedium}"
                                                            FontWeight="SemiBold"
                                                        />
                                                    <TextBlock
                                                            Text="{Binding Path}"
                                                            Foreground="{DynamicResource TextSubtleBrush}"
                                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                                            FontSize="{DynamicResource FontSizeCaption}"
                                                            TextTrimming="CharacterEllipsis"
                                                        />
                                                </StackPanel>
                                                <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding Shortcut}"
                                                        Foreground="{DynamicResource TextSubtleBrush}"
                                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                        VerticalAlignment="Center"
                                                    />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                    x:Name="RecentEmptyText"
                                    Text="No recent projects yet."
                                    Margin="10,14"
                                    Foreground="{DynamicResource TextSubtleBrush}"
                                    FontStyle="Italic"
                                />
                            <TextBlock
                                    x:Name="WelcomeStatus"
                                    Margin="8,20,8,0"
                                    Text="Helix  ·  git / project  ·  runner  ·  OpenCode"
                                    Foreground="{DynamicResource TextFaintBrush}"
                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid
                    x:Name="WorkspaceRoot"
                    Visibility="Collapsed"
                    Background="{DynamicResource TerminalBrush}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid
                        Grid.Row="0"
                        x:Name="PaneGrid"
                        Background="{DynamicResource TerminalBrush}"
                    >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                                x:Name="LeftPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                        <ColumnDefinition
                                x:Name="LeftSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="CenterPaneColumn"
                                Width="58*"
                                MinWidth="500"
                            />
                        <ColumnDefinition
                                x:Name="RightSplitterColumn"
                                Width="3"
                            />
                        <ColumnDefinition
                                x:Name="RightPaneColumn"
                                Width="21*"
                                MinWidth="220"
                            />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="LeftPane"
                        Grid.Column="0"
                    >
                        <Grid.RowDefinitions><RowDefinition
                                    Height="27"
                                /><RowDefinition
                                    Height="*"
                                /></Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{DynamicResource PaneHeaderStyle}"
                            >
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                        Grid.Column="0"
                                        x:Name="LeftPaneTitle"
                                        Text="GIT"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Foreground="{DynamicResource TextPaneTitleBrush}"
                                    />
                                <TextBlock
                                        Grid.Column="1"
                                        x:Name="GitPaneState"
                                        Text="starting"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextIdleBrush}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                    />
                                <TextBlock
                                        Grid.Column="1"
                                        x:Name="ProjectPaneState"
                                        Text="starting"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextIdleBrush}"
                                        FontSize="{DynamicResource FontSizeSmall}"
                                        Visibility="Collapsed"
                                    />
                            </Grid>
                        </Border>
                        <Grid
                                Grid.Row="1"
                                x:Name="LeftToolStack"
                                Background="{DynamicResource TerminalBrush}"
                            />
                    </Grid>

                    <GridSplitter
                            Grid.Column="1"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                    x:Name="EditorPaneRow"
                                    Height="80*"
                                    MinHeight="220"
                                />
                            <RowDefinition
                                    x:Name="RunnerSplitterRow"
                                    Height="3"
                                />
                            <RowDefinition
                                    x:Name="RunnerPaneRow"
                                    Height="20*"
                                    MinHeight="100"
                                />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{DynamicResource PaneHeaderStyle}"
                                >
                                <!-- A Grid rather than a DockPanel: the strip has to be the
                                     flexible element so it gives up width when the pane is
                                     narrow. Docked children are measured in order and each
                                     takes what it asks for, so a capped strip still pushed the
                                     + button and the state text off the right edge once the
                                     tab list grew. -->
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Grid.Column="0"
                                            Text="HELIX"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="{DynamicResource TextPaneTitleBrush}"
                                        />
                                    <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Margin="8,6"
                                            Background="{DynamicResource BorderBrush}"
                                            VerticalAlignment="Center"
                                        />
                                    <Border
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            Margin="9,0,4,0"
                                            Background="Transparent"
                                            ClipToBounds="True">
                                            <!-- The tab strip is clipped to the header row, so a
                                                 long list of tabs slides out of sight instead of
                                                 spilling down the pane. -->
                                            <ScrollViewer
                                                    x:Name="EditorTabStripScroll"
                                                    PreviewMouseWheel="TabStrip_MouseWheel"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Disabled"
                                                    Focusable="False"
                                            >
                                                <ItemsControl x:Name="EditorTabStrip">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
<Border MouseEnter="Tab_MouseEnter" MouseLeave="Tab_MouseLeave"
                                                                    Background="{Binding Background}"
                                                                    Padding="9,0,4,0"
                                                                    BorderThickness="0,0,0,2"
                                                                    BorderBrush="{Binding Underline}"
                                                                    ToolTip="{Binding ToolTipText}">
                                                                <StackPanel
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                    <!-- Activation is bound to the label rather
                                                                         than to the whole tab. With the close
                                                                         button inside a tab that also handled
                                                                         MouseLeftButtonUp, the two targets
                                                                         competed and the close never fired. -->
                                                                    <TextBlock
                                                                            Text="{Binding Name}"
                                                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                                                            FontSize="{DynamicResource FontSizeSmall}"
                                                                            Foreground="{Binding Foreground}"
                                                                            FontWeight="{Binding Weight}"
                                                                            MaxWidth="160"
                                                                            Padding="0,0,6,0"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            VerticalAlignment="Center"
                                                                            Cursor="Hand"
                                                                            Tag="{Binding}"
                                                                            MouseLeftButtonUp="EditorTab_Click"
                                                                    />
                                                                    <!-- A real button rather than a glyph to aim
                                                                         at, and a generous one: 16x16 was easy to
                                                                         miss in a header row this short. -->
                                                                    <Grid
                                                                        Width="20"
                                                                        Height="22"
                                                                    >
                                                                        <Ellipse
                                                                            x:Name="AttentionDot"
                                                                            Width="7"
                                                                            Height="7"
                                                                            Fill="{DynamicResource SuccessBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                                Visibility="{Binding ShowAttentionDot, Converter={StaticResource BoolToVis}}"
                                                                        />
                                                                        <Button
                                                                            x:Name="TabClose"
                                                                            Width="20"
                                                                            Height="22"
                                                                            Padding="0"
                                                                                Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                                                                            Click="EditorTab_Close"
                                                                            Tag="{Binding}"
                                                                            Content="×"
                                                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                                                            FontSize="{DynamicResource FontSizeMedium}"
                                                                            Foreground="{Binding Foreground}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            ToolTip="Close this tab"
                                                                        >
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border
                                                                                        x:Name="CloseSurface"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        CornerRadius="2"
                                                                                >
                                                                                    <ContentPresenter
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"
                                                                                    />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <Button
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                x:Name="EditorTabSplitButton"
                                                Width="22"
                                                Height="27"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                Click="EditorTabSplitButton_Click"
                                                Content="+"
                                                FontFamily="{DynamicResource UiMonoFontFamily}"
                                                FontSize="{DynamicResource FontSizeMedium}"
                                                Foreground="{DynamicResource TextSubtleBrush}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="New empty editor tab"
                                        >
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                            x:Name="SplitSurface"
                                                            Background="{TemplateBinding Background}"
                                                            Width="22"
                                                            Height="27"
                                                    >
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SplitSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                </Grid>
                            </Border>
                            <Grid
                                    Grid.Row="1"
                                    x:Name="EditorSlot"
                                    Background="{DynamicResource TerminalBrush}"
                                />
                        </Grid>
                        <GridSplitter
                                Grid.Row="1"
                                Height="3"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource HorizontalSplitterStyle}"
                                DragCompleted="LayoutSplitter_DragCompleted"
                            />
                        <Grid
                                x:Name="RunnerPane"
                                Grid.Row="2"
                            >
                            <Grid.RowDefinitions><RowDefinition
                                        Height="27"
                                    /><RowDefinition
                                        Height="*"
                                    /></Grid.RowDefinitions>
                            <Border
                                    Grid.Row="0"
                                    Style="{DynamicResource PaneHeaderStyle}"
                                >
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                            Grid.Column="0"
                                            Text="RUN"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="{DynamicResource TextPaneTitleBrush}"
                                        />
                                    <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Margin="8,6"
                                            Background="{DynamicResource BorderBrush}"
                                            VerticalAlignment="Center"
                                        />
                                    <Border
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Height="27"
                                            Margin="9,0,4,0"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                        >
                                        <ScrollViewer
                                                x:Name="RunnerTabStripScroll"
                                                PreviewMouseWheel="TabStrip_MouseWheel"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Disabled"
                                                Focusable="False"
                                        >
                                            <ItemsControl x:Name="RunnerTabStrip" Margin="0,1,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
<Border MouseEnter="Tab_MouseEnter" MouseLeave="Tab_MouseLeave"
                                                                Background="{Binding Background}"
                                                                Padding="9,0,4,0"
                                                                BorderThickness="0,0,0,2"
                                                                BorderBrush="{Binding Underline}"
                                                                ToolTip="{Binding Name}"
                                                        >
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock
                                                                    Text="{Binding Name}"
                                                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                                        Foreground="{Binding Foreground}"
                                                                        FontWeight="{Binding Weight}"
                                                                        MaxWidth="70"
                                                                        Padding="0,0,4,0"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        VerticalAlignment="Center"
                                                                        Cursor="Hand"
                                                                        Tag="{Binding}"
                                                                        MouseLeftButtonUp="RunnerTabStrip_Click"
                                                                    />
                                                                <Grid
                                                                        Width="16"
                                                                        Height="22"
                                                                    >
                                                                        <Ellipse
                                                                            x:Name="AttentionDot"
                                                                            Width="6"
                                                                            Height="6"
                                                                            Fill="{DynamicResource SuccessBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                                Visibility="{Binding ShowAttentionDot, Converter={StaticResource BoolToVis}}"
                                                                        />
                                                                        <Button
                                                                        x:Name="TabClose"
                                                                        Width="16"
                                                                        Height="22"
                                                                        Padding="0"
                                                                            Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                                                                        Click="RunnerTabClose_Click"
                                                                        Tag="{Binding}"
                                                                        Content="×"
                                                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                                                        FontSize="{DynamicResource FontSizeSmall}"
                                                                        Foreground="{DynamicResource TextSubtleBrush}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        ToolTip="Close session"
                                                                    >
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border
                                                                                    x:Name="CloseSurface"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="2"
                                                                                    Width="16"
                                                                                    Height="22"
                                                                                >
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                    </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <Button
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            x:Name="RunnerNewSessionButton"
                                            Click="RunnerNewSessionButton_Click"
                                            ToolTip="New runner session"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="22"
                                            Height="27"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            Foreground="{DynamicResource TextSubtleBrush}"
                                            Cursor="Hand"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeMedium}"
                                            Content="+"
                                        >
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                        x:Name="SplitSurface"
                                                        Background="{TemplateBinding Background}"
                                                        Width="22"
                                                        Height="27"
                                                    >
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SplitSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <ContentControl
                                    Grid.Row="1"
                                    x:Name="RunnerSlot"
                                    Style="{DynamicResource TerminalSlotStyle}"
                                />
                        </Grid>
                    </Grid>

                    <GridSplitter
                            Grid.Column="3"
                            Width="3"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource VerticalSplitterStyle}"
                            DragCompleted="LayoutSplitter_DragCompleted"
                        />

                        <Grid
                            x:Name="AgentPane"
                            Grid.Column="4"
                        >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" MinHeight="32" />
                            </Grid.RowDefinitions>
                        <Border
                                Grid.Row="0"
                                Style="{DynamicResource PaneHeaderStyle}"
                            >
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Title -->
                                <TextBlock
                                        Grid.Column="0"
                                        x:Name="AgentPaneTitle"
                                        Text="OPENCODE"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Foreground="{DynamicResource TextPaneTitleBrush}"
                                    />
                                <!-- Separator -->
                                <Border
                                        Grid.Column="1"
                                        Width="1"
                                        Margin="8,6"
                                        Background="{DynamicResource BorderBrush}"
                                        VerticalAlignment="Center"
                                    />
                                <!-- Session tab strip -->
                                <Border
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Height="27"
                                        Margin="9,0,4,0"
                                        Background="Transparent"
                                        ClipToBounds="True"
                                    >
                                    <ScrollViewer
                                            x:Name="AgentTabStripScroll"
                                            PreviewMouseWheel="TabStrip_MouseWheel"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Disabled"
                                            Focusable="False"
                                    >
                                        <ItemsControl x:Name="AgentTabStrip" Margin="0,1,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
<Border MouseEnter="Tab_MouseEnter" MouseLeave="Tab_MouseLeave"
                                                                Background="{Binding Background}"
                                                                Padding="9,0,4,0"
                                                                BorderThickness="0,0,0,2"
                                                                BorderBrush="{Binding Underline}"
                                                                ToolTip="{Binding Name}"
                                                            >
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock
                                                                        Text="{Binding Name}"
                                                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                                    Foreground="{Binding Foreground}"
                                                                    FontWeight="{Binding Weight}"
                                                                    MaxWidth="70"
                                                                    Padding="0,0,4,0"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    MouseLeftButtonUp="AgentTabStrip_Click"
                                                                />
                                                            <Grid
                                                                        Width="16"
                                                                        Height="22"
                                                                    >
                                                                        <Ellipse
                                                                            x:Name="AttentionDot"
                                                                            Width="6"
                                                                            Height="6"
                                                                            Fill="{DynamicResource SuccessBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                                Visibility="{Binding ShowAttentionDot, Converter={StaticResource BoolToVis}}"
                                                                        />
                                                                        <Button
                                                                            x:Name="TabClose"
                                                                            Width="16"
                                                                            Height="22"
                                                                            Padding="0"
                                                                                Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVis}}"
                                                                            Click="AgentTabClose_Click"
                                                                    Tag="{Binding}"
                                                                    Content="×"
                                                                    FontFamily="{DynamicResource UiMonoFontFamily}"
                                                                    FontSize="{DynamicResource FontSizeSmall}"
                                                                    Foreground="{DynamicResource TextSubtleBrush}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    ToolTip="Close session"
                                                                >
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                                x:Name="CloseSurface"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="2"
                                                                                Width="16"
                                                                                Height="22"
                                                                            >
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                                    </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <!-- + icon -->
                                <Button
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        x:Name="AgentNewSessionButton"
                                        Click="AgentNewSessionButton_Click"
                                        ToolTip="New agent session"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="22"
                                        Height="27"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        Foreground="{DynamicResource TextSubtleBrush}"
                                        Cursor="Hand"
                                        FontFamily="{DynamicResource UiMonoFontFamily}"
                                        FontSize="{DynamicResource FontSizeMedium}"
                                        Content="+"
                                    >
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                    x:Name="SplitSurface"
                                                    Background="{TemplateBinding Background}"
                                                    Width="22"
                                                    Height="27"
                                                >
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SplitSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Flyout for new agent session -->
                        <Popup
                                x:Name="AgentNewSessionFlyout"
                                PlacementTarget="{Binding ElementName=AgentNewSessionButton}"
                                Placement="Bottom"
                                StaysOpen="False"
                                AllowsTransparency="True"
                            >
                            <Border
                                    Background="{DynamicResource PaneHeaderBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="8"
                                >
                                <StackPanel>
                                    <TextBlock
                                            Text="NEW SESSION"
                                            FontFamily="{DynamicResource UiMonoFontFamily}"
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Foreground="{DynamicResource TextFaintBrush}"
                                            Margin="0,0,0,6"
                                        />
                                    <Button
                                            x:Name="NewOpenCodeButton"
                                            Click="NewOpenCodeButton_Click"
                                            Style="{DynamicResource WelcomeActionStyle}"
                                            Padding="8,4"
                                            Margin="0,0,0,4"
                                            HorizontalContentAlignment="Left"
                                        >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="New OpenCode session" FontSize="{DynamicResource FontSizeBody}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                            x:Name="NewCodexButton"
                                            Click="NewCodexButton_Click"
                                            Style="{DynamicResource WelcomeActionStyle}"
                                            Padding="8,4"
                                            HorizontalContentAlignment="Left"
                                        >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF0A0;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="New Codex session" FontSize="{DynamicResource FontSizeBody}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- Agent session content -->
                        <ContentControl
                                Grid.Row="1"
                                x:Name="AgentSlot"
                                Style="{DynamicResource TerminalSlotStyle}"
                            />
                    </Grid>
                </Grid>

                <Border
                        Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                    >
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="GitPanelToggle"
                                    Click="GitPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show git panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/git.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="ProjectPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="ProjectPanelToggle_Click"
                                    IsChecked="False"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show project panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/project.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                        </StackPanel>
                        <StackPanel
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                            >
                            <ToggleButton
                                    x:Name="TerminalPanelToggle"
                                    Click="TerminalPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show terminal panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/terminal.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                            <ToggleButton
                                    x:Name="AgentPanelToggle"
                                    Margin="2,0,0,0"
                                    Click="AgentPanelToggle_Click"
                                    IsChecked="True"
                                    Style="{DynamicResource PanelToggleStyle}"
                                    ToolTip="Show agent panel"
                                >
                                    <Image
                                            Source="/src/Assets/icons/agent.png"
                                            Style="{DynamicResource PanelIconStyle}"
                                        />
                                </ToggleButton>
                         </StackPanel>
                     </Grid>
                 </Border>
             </Grid>
         </Grid>
         </Grid>

        <!-- A top-level Popup rather than an overlay inside the tree. Every pane is an
             HwndHost-backed terminal renderer, and WPF has no z-order authority over a
             child HWND: anything drawn in-tree would slide under the editor and agent
             panes. A Popup is a real layered window and sits above them. -->
        <Popup x:Name="CommandPalettePopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="CommandPalettePopup_Opened"
               PopupAnimation="None">
            <ui:CommandPalette x:Name="CommandPaletteControl" />
        </Popup>

        <!-- The same overlay pattern for the folder picker. A separate popup rather
             than a mode inside the palette: the palette's keyboard model is about
             running commands, and this one is about walking a tree. -->
        <Popup x:Name="FolderPickerPopup"
               Placement="Center"
               AllowsTransparency="True"
               Focusable="True"
               StaysOpen="False"
               Opened="FolderPickerPopup_Opened"
               PopupAnimation="None">
            <ui:FolderPicker x:Name="FolderPickerControl"
                             Picked="FolderPicker_Picked"
                             Dismissed="CloseFolderPicker" />
        </Popup>
    </Grid>
</Window>
