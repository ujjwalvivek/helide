<UserControl x:Class="Helide.Shell.OpenCodeUpdateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource TerminalBrush}">
    <UserControl.Resources>
        <!-- The yazi offer's quiet button, for the same job: the action that is not the
             one being asked for. -->
        <Style x:Key="CardQuietStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                        >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedStrongBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The whole pane, as the yazi offer is: text at the top, the answer pinned to the
         bottom, straight on the terminal background. -->
    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image
                Source="/src/Assets/icons/agent.png"
                Width="14"
                Height="14"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
            />
            <TextBlock
                Text="OpenCode needs updating"
                Foreground="{DynamicResource TextBrush}"
                FontSize="{DynamicResource FontSizeLarge}"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
            />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,10,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextMutedBrush}"
            FontSize="{DynamicResource FontSizeBody}"
            LineHeight="16"
            Text="OpenCode 1 is installed, and Helide runs OpenCode 2. Version 1 cannot bring a conversation back after a restart or mark a finished turn on its tab, so this pane stays closed to it. Your other agents are not affected."
        />

        <!-- What typing /update runs, set apart the way a command in a terminal would be. -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="8,6"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
        >
            <TextBlock
                x:Name="CommandText"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextSubtleBrush}"
                FontFamily="{DynamicResource UiMonoFontFamily}"
                FontSize="{DynamicResource FontSizeSmall}"
            />
        </Border>

        <TextBlock
            Grid.Row="3"
            x:Name="StatusText"
            Margin="0,10,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextSubtleBrush}"
            FontSize="{DynamicResource FontSizeSmall}"
            LineHeight="15"
            Visibility="Collapsed"
        />

        <StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Vertical">
            <TextBlock
                Margin="1,0,0,6"
                Style="{DynamicResource SectionLabelStyle}"
                Text="TYPE /update AND PRESS ENTER"
            />

            <!-- The command the user would have typed into OpenCode itself, taken here
                 because that OpenCode is the one thing this pane will not start. -->
            <Border
                Padding="8,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PressedBrush}"
                BorderThickness="1"
            >
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="&gt;"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentBrush}"
                        FontFamily="{DynamicResource UiMonoFontFamily}"
                        FontSize="{DynamicResource FontSizeBody}"
                    />
                    <TextBox
                        Grid.Column="1"
                        x:Name="InputBox"
                        KeyDown="InputBox_KeyDown"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        VerticalContentAlignment="Center"
                        Foreground="{DynamicResource TextBrush}"
                        CaretBrush="{DynamicResource AccentBrush}"
                        SelectionBrush="{DynamicResource AccentBrush}"
                        FontFamily="{DynamicResource UiMonoFontFamily}"
                        FontSize="{DynamicResource FontSizeBody}"
                    />
                </Grid>
            </Border>

            <Button
                Click="CheckButton_Click"
                Margin="0,6,0,0"
                Style="{DynamicResource CardQuietStyle}"
                Content="I updated it myself, check again"
            />
        </StackPanel>
    </Grid>
</UserControl>
