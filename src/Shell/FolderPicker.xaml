<UserControl x:Class="Helide.Shell.FolderPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False"
             Unloaded="FolderPicker_Unloaded"
             Width="620">
    <UserControl.Resources>
        <!-- Same slim themed scrollbar the palette uses: the WPF default is a wide
             grey trough with arrow buttons, which is out of place on this surface and
             eats the list's right margin. -->
        <Style x:Key="PaletteScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar"
                                Background="{DynamicResource PressedBrush}"
                                Width="4"
                                HorizontalAlignment="Right" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource TextFaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PaletteScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PopoverBrush}"
            BorderBrush="{DynamicResource PressedBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.55"
                              Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Query strip, laid out as the palette's is. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PaneHeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,12,0">
                <Grid Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE8B7;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="QueryBox"
                                 TextChanged="QueryBox_TextChanged"
                                 PreviewKeyDown="QueryBox_PreviewKeyDown"
                                 FontFamily="{DynamicResource UiFontFamily}"
                                 FontSize="{DynamicResource FontSizeLarge}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="Type a folder"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QueryBox}"
                                                     Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- Live while the tree walk is still filling the list. The list is
                         usable long before this clears on a large project, so it is a
                         progress note rather than a gate. -->
                    <TextBlock Grid.Column="2"
                               x:Name="ScanText"
                               Text="scanning…"
                               Style="{DynamicResource SectionLabelStyle}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="392"
                     MinHeight="84"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0,4"
                     HorizontalContentAlignment="Stretch"
                     MouseLeftButtonUp="Results_MouseLeftButtonUp"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- The palette's row: the marker is an edge of the
                                         row rather than a bar floating inside it, so the
                                         highlight is one flat band from border to border. -->
                                    <Border x:Name="Row"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="2,0,0,0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource TabActiveBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource InteractiveBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Depth is the only indent cue a flat list of paths has, so a
                             group of siblings reads as a group rather than as noise. The
                             indent sits inside the row's own margin, so the selection
                             band still runs the full width. -->
                        <Grid Margin="10,0,10,0">
                            <Grid Height="27" Margin="{Binding Indent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Where the folder sits, in the row like the palette's
                                     note. It used to be a tooltip, which opened over the
                                     row below the one it was describing. -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Note}"
                                           FontFamily="{DynamicResource UiMonoFontFamily}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"
                                           MaxWidth="300"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Glyph lives in the style, not in attributes: a local value
                                     would outrank every trigger below it, and the pinned rows
                                     would all carry the folder icon whatever they triggered. -->
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE8B7;" />
                                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                            <Style.Triggers>
                                                <!-- The pinned rows are not folders: a back arrow
                                                     above the tree and a "go elsewhere" arrow
                                                     below it. -->
                                                <DataTrigger Binding="{Binding IsBack}" Value="True">
                                                    <Setter Property="Text" Value="&#xE72B;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBrowse}" Value="True">
                                                    <Setter Property="Text" Value="&#x2197;" />
                                                    <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Folder names are paths, so they keep the mono face; the
                                     pinned rows are commands and read as the palette's do.
                                     Set in the style for the glyph's reason. -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeMedium}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBrowse}" Value="True">
                                                    <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBack}" Value="True">
                                                    <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Shown when a query matches no folder, alongside the pinned rows that
                 still can. A blank panel reads as a broken picker; a note saying
                 the tree is empty leaves the way out visible. -->
            <TextBlock x:Name="EmptyText"
                       Grid.Row="1"
                       Text="No matching folders"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,28"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />

            <!-- Status strip: what the keys do on the left, how much matched on the right. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PaneHeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{DynamicResource KeyBadgeStyle}">
                            <TextBlock Text="Enter" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <TextBlock Text="open" Style="{DynamicResource SectionLabelStyle}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{DynamicResource KeyBadgeStyle}">
                            <TextBlock Text="↑" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <Border Style="{DynamicResource KeyBadgeStyle}" Margin="3,0,0,0">
                            <TextBlock Text="↓" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <TextBlock Text="move" Style="{DynamicResource SectionLabelStyle}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{DynamicResource KeyBadgeStyle}">
                            <TextBlock Text="Esc" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <TextBlock Text="close" Style="{DynamicResource SectionLabelStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="CountText"
                               Grid.Column="1"
                               Style="{DynamicResource SectionLabelStyle}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
