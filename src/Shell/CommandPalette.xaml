<UserControl x:Class="Helide.Shell.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False"
             Width="620">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            A slim themed scrollbar. The WPF default is a wide grey trough with arrow
            buttons at each end, which is both out of place against this surface and
            wide enough to eat the list's right margin. Arrows are removed because the
            wheel and the keyboard both drive this list.
        -->
        <Style x:Key="PaletteScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar"
                                Background="{DynamicResource PressedBrush}"
                                Width="4"
                                HorizontalAlignment="Right" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource TextFaintBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PaletteScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PopoverBrush}"
            BorderBrush="{DynamicResource PressedBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.55"
                              Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Query strip. Columns so the icon, the caret and the placeholder cannot
                 land on top of each other; they previously shared one cell and the
                 placeholder sat under the glyph. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PaneHeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,10,0">
                <Grid Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="QueryBox"
                                 TextChanged="QueryBox_TextChanged"
                                 PreviewKeyDown="QueryBox_PreviewKeyDown"
                                 FontFamily="{DynamicResource UiFontFamily}"
                                 FontSize="{DynamicResource FontSizeLarge}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalContentAlignment="Center" />
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Type a command"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QueryBox}"
                                                     Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border x:Name="ShortcutBadge" Grid.Column="2" Style="{DynamicResource KeyBadgeStyle}">
                        <TextBlock Text="Ctrl Shift P" Style="{DynamicResource KeyBadgeTextStyle}" />
                    </Border>
                </Grid>
            </Border>

            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="392"
                     MinHeight="84"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0,4"
                     HorizontalContentAlignment="Stretch"
                     MouseLeftButtonUp="Results_MouseLeftButtonUp"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- The marker is an edge of the row rather than a bar
                                         floating inside it, so the highlight is one flat
                                         band from the left border to the right. -->
                                    <Border x:Name="Row"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="2,0,0,0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource TabActiveBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource InteractiveBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <!-- A heading cannot be run, so it is not a target:
                                             no band under the pointer and no hand cursor. -->
                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Headings and commands share one template so the list stays a
                             single flat collection; IsHeading picks which half shows. -->
                        <Grid>
                            <!-- Heading -->
                            <TextBlock Text="{Binding Title}"
                                       Style="{DynamicResource SectionLabelStyle}"
                                       Margin="12,9,12,3"
                                       Visibility="{Binding IsHeading, Converter={StaticResource BoolToVis}}" />

                            <!-- Command -->
                            <Grid Height="27"
                                  Margin="10,0,10,0"
                                  Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- A note: a path, or a word about what the command does. -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Note}"
                                           FontFamily="{DynamicResource UiMonoFontFamily}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"
                                           MaxWidth="300"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- A shortcut: one cap per key. -->
                                <ItemsControl Grid.Column="3"
                                              ItemsSource="{Binding Keys}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              Margin="12,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource KeyBadgeStyle}" Margin="3,0,0,0">
                                                <TextBlock Text="{Binding}" Style="{DynamicResource KeyBadgeTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Shown instead of the list when a query matches nothing. A blank panel
                 reads as a broken palette rather than as an empty result. -->
            <TextBlock x:Name="EmptyText"
                       Grid.Row="1"
                       Text="No matching commands"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,28"
                       Visibility="Collapsed" />

            <!-- Status strip: what the keys do on the left, how much matched on the right. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PaneHeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{DynamicResource KeyBadgeStyle}">
                            <TextBlock Text="Enter" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <TextBlock x:Name="EnterLabel" Text="run" Style="{DynamicResource SectionLabelStyle}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{DynamicResource KeyBadgeStyle}">
                            <TextBlock Text="↑" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <Border Style="{DynamicResource KeyBadgeStyle}" Margin="3,0,0,0">
                            <TextBlock Text="↓" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <TextBlock Text="move" Style="{DynamicResource SectionLabelStyle}" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{DynamicResource KeyBadgeStyle}">
                            <TextBlock Text="Esc" Style="{DynamicResource KeyBadgeTextStyle}" />
                        </Border>
                        <TextBlock Text="close" Style="{DynamicResource SectionLabelStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="CountText"
                               Grid.Column="1"
                               Style="{DynamicResource SectionLabelStyle}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
