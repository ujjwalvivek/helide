<Application
    x:Class="Helide.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is theme-independent and never swapped. Index 1 is the
                     active palette, replaced in place by ThemePalette.ApplyTheme. -->
                <ResourceDictionary
                    Source="pack://application:,,,/src/Theme/Foundation.xaml"
                />
                <ResourceDictionary
                    Source="pack://application:,,,/src/Theme/Themes/CatppuccinMocha.xaml"
                />
            </ResourceDictionary.MergedDictionaries>

            <!-- Everything below is shared chrome: pieces more than one window draws, kept
                 here so they cannot drift apart. Colours are DynamicResource throughout,
                 so a theme switch reaches them like everything else.

                 Nothing in the app is rounded. Square corners are the house style, and
                 the only curves are the three window buttons and the attention dots. -->

            <!-- Hover hints. The stock tooltip is a light system-coloured box with a drop
                 shadow, which is the one thing on screen that ignores the theme. -->
            <Style TargetType="ToolTip">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Placement" Value="Bottom" />
                <Setter Property="VerticalOffset" Value="6" />
                <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border
                                Background="{DynamicResource PopoverBrush}"
                                BorderBrush="{DynamicResource PressedBrush}"
                                BorderThickness="1"
                                Padding="8,4"
                                SnapsToDevicePixels="True"
                            >
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A key cap: the small bordered label a shortcut is shown in. -->
            <Style x:Key="KeyBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource InteractiveBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PressedBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="5,1,5,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="KeyBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource MauveBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- The small capitalised label above a group of rows. -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            </Style>

            <!-- The two answers a pane can ask for: the filled primary action and the
                 outlined alternative under it. Shared by every card that fills a pane with a
                 question, so they cannot drift apart. -->
            <Style x:Key="CardAcceptStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="AcceptSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                            >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AcceptSurface" Property="Background" Value="{DynamicResource MauveBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="AcceptSurface" Property="Background" Value="{DynamicResource PressedStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="AcceptSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Not BasedOn the accept style. A derived style keeps the base triggers, and
                 those paint the surface the accent's hover colour: light mauve under grey
                 muted text, which is not readable. So this one carries its own template and
                 its own hover, the pane's interactive colour with the strong text colour on
                 top of it. -->
            <Style x:Key="CardDeclineStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="DeclineSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                            >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeclineSurface" Property="Background" Value="{DynamicResource InteractiveBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="DeclineSurface" Property="Background" Value="{DynamicResource PressedStrongBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
