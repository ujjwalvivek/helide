<Application
    x:Class="Helide.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is theme-independent and never swapped. Index 1 is the
                     active palette, replaced in place by ThemePalette.ApplyTheme. -->
                <ResourceDictionary Source="pack://application:,,,/src/Theme/Foundation.xaml" />
                <ResourceDictionary Source="pack://application:,,,/src/Theme/Themes/CatppuccinMocha.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>