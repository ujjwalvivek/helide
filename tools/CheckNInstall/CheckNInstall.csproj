<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CheckNInstall</AssemblyName>
    <RootNamespace>Helide.Tooling</RootNamespace>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <Version>1.1.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <ApplicationIcon>..\..\src\Assets\helide.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Assets\helide.txt" LogicalName="helide.txt" />
  </ItemGroup>

  <PropertyGroup>
    <_CheckNInstallArtifactName>CheckNInstall-$(RuntimeIdentifier).exe</_CheckNInstallArtifactName>
    <_CheckNInstallArtifactName Condition="'$(RuntimeIdentifier)' == ''">CheckNInstall.exe</_CheckNInstallArtifactName>
  </PropertyGroup>

  <!--
      Same flatten as Helide and AutoUpdater: publish leaves its bundle in a publish
      folder under the RID directory, this moves the single exe up to bin\Release\
      net8.0-windows and deletes the folder, so the release directory holds one file.
  -->
  <UsingTask TaskName="FlattenPublishOutput" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutDir ParameterType="System.String" Required="true" />
      <PublishName ParameterType="System.String" Required="true" />
      <FinalName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          var loose = Path.GetFullPath(OutDir);
          var root = Path.GetDirectoryName(loose.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
          var publish = Path.GetFullPath(Path.Combine(loose, PublishName));

          if (Directory.Exists(publish))
          {
              Directory.CreateDirectory(root);

              var bundled = Directory.EnumerateFiles(publish).ToList();
              foreach (var file in bundled)
              {
                  var name = bundled.Count == 1 ? FinalName : Path.GetFileName(file);
                  var target = Path.Combine(root, name);
                  if (File.Exists(target))
                      File.Delete(target);
                  File.Move(file, target);
              }

              Directory.Delete(publish, true);
          }

          foreach (var file in Directory.EnumerateFiles(loose))
              File.Delete(file);

          foreach (var dir in Directory.EnumerateDirectories(loose))
              Directory.Delete(dir, true);

          Directory.Delete(loose, true);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="DropNativeDebugSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_SymbolJunk Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_SymbolJunk)" />
  </Target>

  <Target Name="FlattenPublishIntoArtifact" AfterTargets="Publish">
    <FlattenPublishOutput OutDir="$(OutDir)" PublishName="publish" FinalName="$(_CheckNInstallArtifactName)" />
  </Target>

</Project>
